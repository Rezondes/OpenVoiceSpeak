    { "folder": "src/OVS.Shared", "rootNamespace": "OVS.Shared", "kind": "Source" },
    { "folder": "src/OVS.Server", "rootNamespace": "OVS.Server", "kind": "Source" },
    { "folder": "src/OVS.Client", "rootNamespace": "OVS.Client", "kind": "Source" },
    { "folder": "tests/OVS.Tests", "rootNamespace": "OVS.Tests", "kind": "Test" },
    { "folder": "tools/render-icon", "rootNamespace": "OVS.Tools", "kind": "Tool" },
    { "folder": "tools/rule-lint", "rootNamespace": "RuleLint", "kind": "Tool" },
    { "folder": "tools/rule-lint-tests", "rootNamespace": "RuleLint.Tests", "kind": "Test" }
  ],
  "partialTypes": [ "ServerState" ],
  "xamlPrefixes": {
    "v": "OVS.Client.Views",
    "vm": "OVS.Client.ViewModels",
    "m": "OVS.Client.Models",
    "ctl": "OVS.Client.Controls",
    "anim": "OVS.Client.Animations",
    "lay": "OVS.Client.Layout",
    "conv": "OVS.Client.Converters",
