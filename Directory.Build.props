<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- Rule 17 (N6): the naming rules of .editorconfig are checked in every build (built-in analyzers, no package). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Rule 23 (W5): every type and non-private member of the product and the tools has XML docs; a missing one is CS1591,
    an error under TreatWarningsAsErrors. Test projects are left out, like rule-lint's RL231.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package 42: raw build data, formatted by src/OVS.Shared/BuildInfo.cs. The release workflow sets OVS_BUILD_TIME
    once per run, so exe and server image carry the same version. Local Debug builds leave the time out and stay
    incremental; GitHub Actions sets GITHUB_SHA and GITHUB_ACTIONS by itself.
  -->
  <PropertyGroup>
    <OvsBuildTime>$(OVS_BUILD_TIME)</OvsBuildTime>
    <OvsBuildTime Condition="'$(OvsBuildTime)' == '' And '$(Configuration)' == 'Release'">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</OvsBuildTime>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OvsBuildTime" Value="$(OvsBuildTime)" Condition="'$(OvsBuildTime)' != ''" />
    <AssemblyMetadata Include="OvsCommit" Value="$(GITHUB_SHA)" Condition="'$(GITHUB_SHA)' != ''" />
    <AssemblyMetadata Include="OvsIsCI" Value="$(GITHUB_ACTIONS)" Condition="'$(GITHUB_ACTIONS)' != ''" />
  </ItemGroup>
</Project>
