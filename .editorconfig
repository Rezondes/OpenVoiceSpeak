root = true

# Rule 17 (N6): the compiler enforces the names it can; rule-lint checks the rest (RL151 to RL155). The Async suffix is
# RL154 for now: a naming rule on async also hits async void event handlers and async test methods, which RL154 exempts.
[*.cs]
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = error

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, delegate, method, local_function, property, event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_and_members_are_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal.style = pascal
dotnet_naming_rule.types_and_members_are_pascal.severity = error

dotnet_diagnostic.IDE1006.severity = error

# Async rule 2 (the user, 13 October 2026): the async variant wherever one exists, and the CancellationToken passed on.
dotnet_diagnostic.CA1849.severity = error
dotnet_diagnostic.CA2016.severity = error

# Step 38 (decision CA a, 13 October 2026): AnalysisMode All, every CA rule an error. Off, with the reason:
# CA1707: the three-part test names (N22) have underscores.
dotnet_diagnostic.CA1707.severity = none
# CA2007: the client continues on the UI thread after an await; ConfigureAwait(false) would leave it.
dotnet_diagnostic.CA2007.severity = none
# CA1062: nullable reference types already say which arguments may be null.
dotnet_diagnostic.CA1062.severity = none

# CA2000: a disposable handed to a constructor or a method belongs to the receiver from then on (the owner disposes it).
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_constructor = true
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_method_call = true

# CA1716: names that are keywords in other languages (the namespace OVS.Shared, the record Error are VB keywords); the code is C# only.
dotnet_diagnostic.CA1716.severity = none

# CA5394: tests make their data with Random on purpose; no security depends on it.
[{tests,tools/rule-lint-tests}/**/*.cs]
dotnet_diagnostic.CA5394.severity = none
