<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OVS.Shared\OVS.Shared.csproj" />
    <!-- Step 30d2 (W6, decided by the user): one Generic Host per run; its container makes the run's parts -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Package 145 (A155): OpenTelemetry, used only when OTEL_EXPORTER_OTLP_ENDPOINT is set -->
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!-- Package 147 (A157): the .NET runtime metrics beside the server's own -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- the tests drive ServerState without sockets and check the request shape directly -->
    <InternalsVisibleTo Include="OVS.Tests" />
  </ItemGroup>

</Project>
