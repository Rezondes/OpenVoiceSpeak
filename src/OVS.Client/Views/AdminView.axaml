<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:OVS.Client.Localization"
             xmlns:vm="using:OVS.Client.ViewModels"
             xmlns:v="using:OVS.Client.Views"
             x:Class="OVS.Client.Views.AdminView"
             x:DataType="vm:AdminViewModel">
  <DockPanel>
    <!-- Page header: title and close (Esc closes as well) -->
    <Border DockPanel.Dock="Top" Padding="24,12,16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}"
                ToolTip.Tip="{x:Static l:Strings.Ui_CloseEsc}" AutomationProperties.Name="{x:Static l:Strings.Ui_CloseAdmin}">
          <PathIcon Data="{StaticResource Icon.Dismiss}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Ovs.AccentSurface}">
            <PathIcon Classes="accent" Data="{StaticResource Icon.ShieldPerson}" />
          </Border>
          <TextBlock Classes="h2" FontSize="17" Text="{x:Static l:Strings.Ui_Admin}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource Ovs.Sidebar}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
            <TextBlock Text="{x:Static l:Strings.Ui_Refresh}" />
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>

    <DockPanel Margin="24,12,24,16">
      <TabControl x:Name="Tabs">
        <!-- ===== Groups ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Groups}" IsVisible="{Binding ShowGroups}">
          <Grid ColumnDefinitions="240,*">
            <Border Classes="card" Padding="6">
              <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding MoveGroupDownCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Ui_MoveDown}" AutomationProperties.Name="{x:Static l:Strings.Ui_GroupDown}">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowDown}" />
                  </Button>
                  <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding MoveGroupUpCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Ui_MoveUp}" AutomationProperties.Name="{x:Static l:Strings.Ui_GroupUp}">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowUp}" />
                  </Button>
                  <Button Classes="subtle" Command="{Binding NewGroupCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Add}" />
                      <TextBlock Text="{x:Static l:Strings.Group_New}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
                <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupEditViewModel">
                      <StackPanel Background="Transparent" PointerPressed="OnGroupPointerPressed" PointerMoved="OnGroupPointerMoved"
                                  PointerReleased="OnGroupPointerReleased" PointerCaptureLost="OnGroupPointerCaptureLost">
                        <Border Classes="dropLine" IsVisible="{Binding IsDropAbove}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Classes="sm muted" Data="{StaticResource Icon.People}" />
                          <TextBlock Text="{Binding DisplayName}" />
                        </StackPanel>
                        <Border Classes="dropLine" IsVisible="{Binding IsDropBelow}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="12,0,0,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                  <Button Classes="accent" Command="{Binding SaveGroupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Checkmark}" />
                      <TextBlock Text="{x:Static l:Strings.Ui_SaveGroup}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="danger" Command="{Binding DeleteGroupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                      <TextBlock Text="{x:Static l:Strings.Ui_DeleteGroup}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_ChooseGroup}" IsVisible="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNull}}" />
                <ContentControl Content="{Binding SelectedGroup}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:GroupEditViewModel">
                      <ScrollViewer>
                        <StackPanel Spacing="8" Margin="0,0,16,0">
                          <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Name}" />
                          <TextBox Text="{Binding Name}" IsEnabled="{Binding IsEditable}" />
                          <Border Classes="banner accent" IsVisible="{Binding IsReadOnly}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <PathIcon Classes="accent" Data="{StaticResource Icon.LockClosed}" />
                              <TextBlock Classes="accent" Text="{x:Static l:Strings.Ui_AdminGroupFixed}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                          <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Rights}" Margin="0,6,0,0" />
                          <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_RightsGreyed}"
                                     IsVisible="{Binding IsEditable}" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding Toggles}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PermissionToggle">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- ===== Users ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Users}" IsVisible="{Binding ShowUsers}">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Users}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KnownUserViewModel">
                  <Border Classes="card" Padding="12,10">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Classes="avatar" Width="32" Height="32" VerticalAlignment="Top"
                              Background="{Binding Nickname, Converter={x:Static v:Ui.AvatarBrush}}">
                        <TextBlock Text="{Binding Nickname, Converter={x:Static v:Ui.Initials}}" FontSize="13" />
                      </Border>
                      <StackPanel Margin="12,0,0,0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" Foreground="{DynamicResource Ovs.Text}" />
                          <TextBlock Classes="caption" Text="{Binding ShortFingerprint}" FontFamily="Cascadia Mono,Consolas,monospace"
                                     VerticalAlignment="Center" ToolTip.Tip="{x:Static l:Strings.Ui_IdentityFingerprint}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Toggles}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupToggle">
                              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding ToggleCommand}" Margin="0,0,16,0" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>

        <!-- ===== Bans ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Bans}" IsVisible="{Binding ShowBans}">
          <Panel>
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding Bans.Count, Converter={x:Static v:Ui.IsZero}}">
              <PathIcon Classes="muted" Data="{StaticResource Icon.Prohibited}" Width="32" Height="32" />
              <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NobodyBanned}" HorizontalAlignment="Center" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Bans}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BanViewModel">
                    <Border Classes="card" Padding="12,10">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding UnbanCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="sm" Data="{StaticResource Icon.Dismiss}" />
                            <TextBlock Text="{x:Static l:Strings.Ui_Unban}" />
                          </StackPanel>
                        </Button>
                        <PathIcon DockPanel.Dock="Left" Classes="danger" Data="{StaticResource Icon.Prohibited}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Classes="body" Text="{Binding Text}" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </TabItem>

        <!-- ===== Server ===== -->
        <!-- ===== Links (Package 38) ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Links}" IsVisible="{Binding ShowLinks}">
          <DockPanel DataContext="{Binding Links}" x:DataType="vm:LinkMatrixViewModel">
            <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{x:Static l:Strings.Ui_LinksHelp}" />
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0" ItemSpacing="8" LineSpacing="8">
              <Button Command="{Binding LinkSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.Link}" />
                  <TextBlock Text="{x:Static l:Strings.Ui_LinkSelected}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding UnlinkSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.LinkDismiss}" />
                  <TextBlock Text="{x:Static l:Strings.Ui_UnlinkSelected}" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding ApplyCommand}" IsEnabled="{Binding HasPending}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.Checkmark}" />
                  <TextBlock Text="{x:Static l:Strings.Ui_Apply}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding DiscardCommand}" IsEnabled="{Binding HasPending}" Content="{x:Static l:Strings.Ui_Discard}" />
              <TextBlock Classes="caption" Text="{Binding PendingText}" VerticalAlignment="Center" />
            </WrapPanel>
            <Border Classes="card" Padding="8">
              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                  <!-- column numbers -->
                  <StackPanel Orientation="Horizontal">
                    <Border Width="228" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkRowViewModel">
                          <TextBlock Classes="caption" Width="34" TextAlignment="Center" Text="{Binding Number}" ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LinkRowViewModel">
                        <StackPanel Orientation="Horizontal">
                          <CheckBox IsChecked="{Binding IsSelected}" Width="36" MinWidth="36"
                                    AutomationProperties.Name="{Binding Name, StringFormat={x:Static l:Strings.Ui_SelectFmt}}" />
                          <TextBlock Width="192" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource Ovs.Text}" ToolTip.Tip="{Binding Name}" />
                          <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:LinkCellViewModel">
                                <Border Classes="linkCell" Classes.pending="{Binding IsPending}" ToolTip.Tip="{Binding Tooltip}">
                                  <CheckBox IsChecked="{Binding IsLinked}" IsVisible="{Binding !IsDiagonal}" MinWidth="0" Padding="0"
                                            HorizontalAlignment="Center" AutomationProperties.Name="{Binding Tooltip, StringFormat={x:Static l:Strings.Ui_LinkFmt}}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </TabItem>

        <TabItem Header="{x:Static l:Strings.Ui_Server}" IsVisible="{Binding ShowServer}">
          <ScrollViewer>
            <Border Classes="card" MaxWidth="560" HorizontalAlignment="Left">
              <StackPanel Spacing="12">
                <!-- Server logo (Package 30): pick a file or drop it onto the preview -->
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_ServerLogo}" />
                  <DockPanel>
                    <Border x:Name="IconDrop" DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="16" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{DynamicResource Ovs.Border}" Background="{DynamicResource Ovs.SurfaceHover}"
                            DragDrop.AllowDrop="True" ToolTip.Tip="{x:Static l:Strings.Ui_DropImage}">
                      <Panel>
                        <PathIcon Classes="muted" Data="{StaticResource Icon.Add}" IsVisible="{Binding IconPng, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Image Source="{Binding IconPng, Converter={x:Static v:Ui.PngToBitmap}}" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <StackPanel Margin="14,0,0,0" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_LogoHint}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnPickIcon">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="sm" Data="{StaticResource Icon.Edit}" />
                            <TextBlock Text="{x:Static l:Strings.Ui_ChooseLogo}" />
                          </StackPanel>
                        </Button>
                        <Button Classes="subtle" Command="{Binding RemoveIconCommand}" IsVisible="{Binding HasIcon}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                            <TextBlock Text="{x:Static l:Strings.Ui_RemoveLogo}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="danger" Text="{Binding IconError}" TextWrapping="Wrap"
                             IsVisible="{Binding IconError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <Border Classes="divider" />

                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_ServerName}" />
                  <TextBox Text="{Binding ServerName}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_WelcomeText}" />
                  <TextBox Text="{Binding WelcomeText}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                  <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_WelcomeHint}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Dlg_ServerPassword}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="sm muted" Data="{StaticResource Icon.LockClosed}" />
                    <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_HasPassword}" IsVisible="{Binding HasPassword}" />
                    <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_NoPassword}" IsVisible="{Binding !HasPassword}" />
                  </StackPanel>
                  <TextBox Text="{Binding NewPassword}" PasswordChar="•" Watermark="{x:Static l:Strings.Ui_NewPassword}" />
                  <CheckBox Content="{x:Static l:Strings.Ui_RemovePassword}" IsChecked="{Binding RemovePassword}" />
                </StackPanel>
                <Button Classes="accent" Command="{Binding SaveServerSettingsCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.Checkmark}" />
                    <TextBlock Text="{x:Static l:Strings.Ui_SaveServerSettings}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</UserControl>
