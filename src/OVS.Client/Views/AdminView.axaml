<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:OVS.Client.Localization"
             xmlns:vm="using:OVS.Client.ViewModels"
             xmlns:v="using:OVS.Client.Views"
             x:Class="OVS.Client.Views.AdminView"
             x:DataType="vm:AdminViewModel">
  <DockPanel>
    <!-- Page header: title and close (Esc closes as well) -->
    <Border DockPanel.Dock="Top" Classes="settingsHeader" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}"
                ToolTip.Tip="{x:Static l:Strings.Ui_CloseEsc}" AutomationProperties.Name="{x:Static l:Strings.Ui_CloseAdmin}">
          <PathIcon Data="{StaticResource Icon.Dismiss}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Ovs.AccentSurface}">
            <PathIcon Classes="accent" Data="{StaticResource Icon.ShieldPerson}" />
          </Border>
          <TextBlock Classes="h2" FontSize="17" Text="{x:Static l:Strings.Ui_Admin}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="settingsBar" Background="{DynamicResource Ovs.Sidebar}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
            <TextBlock Text="{x:Static l:Strings.Ui_Refresh}" />
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>

    <DockPanel Classes="adminBody">
      <TabControl x:Name="Tabs">
        <!-- ===== Groups ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Groups}" IsVisible="{Binding ShowGroups}">
          <!-- Package 78: list beside the editor, under narrow above it (styles in Controls.axaml) -->
          <Grid Classes="adminGroups" ColumnDefinitions="Auto,*" RowDefinitions="2*,3*">
            <Border Classes="card groupList" Padding="6">
              <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding MoveGroupDownCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Ui_MoveDown}" AutomationProperties.Name="{x:Static l:Strings.Ui_GroupDown}">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowDown}" />
                  </Button>
                  <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding MoveGroupUpCommand}"
                          ToolTip.Tip="{x:Static l:Strings.Ui_MoveUp}" AutomationProperties.Name="{x:Static l:Strings.Ui_GroupUp}">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowUp}" />
                  </Button>
                  <Button Classes="subtle" Command="{Binding NewGroupCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Add}" />
                      <TextBlock Text="{x:Static l:Strings.Group_New}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
                <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupEditViewModel">
                      <StackPanel Background="Transparent" PointerPressed="OnGroupPointerPressed" PointerMoved="OnGroupPointerMoved"
                                  PointerReleased="OnGroupPointerReleased" PointerCaptureLost="OnGroupPointerCaptureLost">
                        <Border Classes="dropLine" IsVisible="{Binding IsDropAbove}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Classes="sm muted" Data="{StaticResource Icon.People}" />
                          <TextBlock Text="{Binding DisplayName}" />
                        </StackPanel>
                        <Border Classes="dropLine" IsVisible="{Binding IsDropBelow}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Classes="card groupEditor">
              <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0">
                  <Button Classes="accent" Command="{Binding SaveGroupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Checkmark}" />
                      <TextBlock Text="{x:Static l:Strings.Ui_SaveGroup}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="danger" Command="{Binding DeleteGroupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                      <TextBlock Text="{x:Static l:Strings.Ui_DeleteGroup}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_ChooseGroup}" IsVisible="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNull}}" />
                <ContentControl Content="{Binding SelectedGroup}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:GroupEditViewModel">
                      <ScrollViewer>
                        <StackPanel Spacing="8" Margin="0,0,16,0">
                          <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Name}" />
                          <TextBox Text="{Binding Name}" IsEnabled="{Binding IsEditable}" />
                          <Border Classes="banner accent" IsVisible="{Binding IsReadOnly}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <PathIcon Classes="accent" Data="{StaticResource Icon.LockClosed}" />
                              <TextBlock Classes="accent" Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                          <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Rights}" Margin="0,6,0,0" />
                          <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_RightsGreyed}"
                                     IsVisible="{Binding IsEditable}" TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding Toggles}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Classes="rights" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PermissionToggle">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </DockPanel>
            </Border>
          </Grid>
        </TabItem>

        <!-- ===== Users (Package 71: everything stored, with search, filters and order) ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Users}" IsVisible="{Binding ShowUsers}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
              <TextBox x:Name="UserSearch" Text="{Binding SearchText}" Watermark="{x:Static l:Strings.Ui_UserSearch}"
                       AutomationProperties.Name="{x:Static l:Strings.Ui_UserSearch}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <ComboBox x:Name="StatusFilter" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"
                          MinWidth="120" AutomationProperties.Name="{x:Static l:Strings.Ui_StatusFilter}" />
                <ComboBox x:Name="GroupFilter" ItemsSource="{Binding GroupFilters}" SelectedItem="{Binding SelectedGroupFilter}"
                          MinWidth="120" MaxWidth="240" AutomationProperties.Name="{x:Static l:Strings.Ui_GroupFilter}" />
                <ComboBox x:Name="SortOrder" ItemsSource="{Binding SortOrders}" SelectedItem="{Binding SelectedSortOrder}"
                          MinWidth="120" AutomationProperties.Name="{x:Static l:Strings.Ui_SortOrder}" />
              </WrapPanel>
              <TextBlock Classes="caption" Text="{Binding UserCountText}" TextWrapping="Wrap" />
            </StackPanel>
            <Panel>
              <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NoUserMatches}" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding Users.Count, Converter={x:Static v:Ui.IsZero}}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Users}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KnownUserViewModel">
                      <Border Classes="card" Padding="12,10">
                        <DockPanel>
                          <Panel DockPanel.Dock="Left" VerticalAlignment="Top" Width="32" Height="32">
                            <Border Classes="avatar" Width="32" Height="32"
                                    Background="{Binding Nickname, Converter={x:Static v:Ui.AvatarBrush}}">
                              <TextBlock Text="{Binding Nickname, Converter={x:Static v:Ui.Initials}}" FontSize="13" />
                            </Border>
                            <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                     Fill="{DynamicResource Ovs.Speaking}" Stroke="{DynamicResource Ovs.Surface}" StrokeThickness="2"
                                     IsVisible="{Binding IsOnline}" ToolTip.Tip="{Binding StatusText}" />
                          </Panel>
                          <StackPanel Margin="12,0,0,0" Spacing="6">
                            <WrapPanel ItemSpacing="8">
                              <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" Foreground="{DynamicResource Ovs.Text}" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding StatusText}" VerticalAlignment="Center" />
                              <TextBlock Classes="caption" Text="{Binding ShortFingerprint}" FontFamily="Cascadia Mono,Consolas,monospace"
                                         VerticalAlignment="Center" ToolTip.Tip="{Binding Fingerprint}" />
                            </WrapPanel>
                            <Border Classes="banner danger" IsVisible="{Binding IsBanned}">
                              <DockPanel>
                                <PathIcon DockPanel.Dock="Left" Classes="sm danger" Data="{StaticResource Icon.Prohibited}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock Classes="danger" Text="{Binding BanText}" TextWrapping="Wrap" />
                              </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Toggles}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupToggle">
                                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding ToggleCommand}" Margin="0,0,16,0" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- two or more columns when wide, one under narrow -->
                            <WrapPanel Classes="userDetails" ItemSpacing="16" LineSpacing="6">
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_FirstSeen}" />
                                <TextBlock Classes="body" Text="{Binding FirstSeenText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_LastLogin}" />
                                <TextBlock Classes="body" Text="{Binding LastLoginText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_LoginCount}" />
                                <TextBlock Classes="body" Text="{Binding LoginCountText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_OnlineTime}" />
                                <TextBlock Classes="body" Text="{Binding OnlineTimeText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_SpeechTime}" />
                                <TextBlock Classes="body" Text="{Binding SpeechTimeText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_ChatMessages}" />
                                <TextBlock Classes="body" Text="{Binding ChatMessagesText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_LastIp}" />
                                <TextBlock Classes="body" Text="{Binding LastIpText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_PreviousNicknames}" />
                                <TextBlock Classes="body" Text="{Binding PreviousNicknamesText}" TextWrapping="Wrap" />
                              </StackPanel>
                            </WrapPanel>
                            <StackPanel>
                              <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_IdentityFingerprint}" />
                              <SelectableTextBlock Classes="caption" Text="{Binding Fingerprint}" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono,Consolas,monospace" />
                            </StackPanel>
                            <!-- Package 72: works for offline users too; deleting asks first -->
                            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0" IsVisible="{Binding HasActions}">
                              <Button Command="{Binding BanCommand}" IsVisible="{Binding CanBan}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Classes="sm" Data="{StaticResource Icon.Prohibited}" />
                                  <TextBlock Text="{x:Static l:Strings.Ui_BanUser}" />
                                </StackPanel>
                              </Button>
                              <Button Command="{Binding UnbanCommand}" IsVisible="{Binding CanUnban}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Classes="sm" Data="{StaticResource Icon.Dismiss}" />
                                  <TextBlock Text="{x:Static l:Strings.Ui_Unban}" />
                                </StackPanel>
                              </Button>
                              <Button Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Classes="sm" Data="{StaticResource Icon.PersonDelete}" />
                                  <TextBlock Text="{x:Static l:Strings.Ui_DeleteUser}" />
                                </StackPanel>
                              </Button>
                            </WrapPanel>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </TabItem>

        <!-- ===== Bans (Package 80: active bans and history with every detail, search, filters and order) ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Bans}" IsVisible="{Binding ShowBans}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
              <TextBox x:Name="BanSearch" Text="{Binding BanSearchText}" Watermark="{x:Static l:Strings.Ui_BanSearch}"
                       AutomationProperties.Name="{x:Static l:Strings.Ui_BanSearch}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <ComboBox x:Name="BanStatusFilter" ItemsSource="{Binding BanStatusFilters}" SelectedItem="{Binding SelectedBanStatusFilter}"
                          MinWidth="120" AutomationProperties.Name="{x:Static l:Strings.Ui_StatusFilter}" />
                <ComboBox x:Name="BanTypeFilter" ItemsSource="{Binding BanTypeFilters}" SelectedItem="{Binding SelectedBanTypeFilter}"
                          MinWidth="120" AutomationProperties.Name="{x:Static l:Strings.Ui_BanTypeFilter}" />
                <ComboBox x:Name="BanSortOrder" ItemsSource="{Binding BanSortOrders}" SelectedItem="{Binding SelectedBanSortOrder}"
                          MinWidth="120" AutomationProperties.Name="{x:Static l:Strings.Ui_SortOrder}" />
              </WrapPanel>
              <TextBlock Classes="caption" Text="{Binding BanCountText}" TextWrapping="Wrap" />
            </StackPanel>
            <Panel>
              <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoBans}">
                <PathIcon Classes="muted" Data="{StaticResource Icon.Prohibited}" Width="32" Height="32" />
                <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NobodyBanned}" HorizontalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NoBanMatches}" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoBanMatches}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Bans}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BanViewModel">
                      <Border Classes="card" Padding="12,10">
                        <DockPanel>
                          <!-- only on active bans and with UserBan; beside the details, under narrow below them -->
                          <Button Classes="cardAction" Command="{Binding UnbanCommand}" IsVisible="{Binding CanUnban}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Classes="sm" Data="{StaticResource Icon.Dismiss}" />
                              <TextBlock Text="{x:Static l:Strings.Ui_Unban}" />
                            </StackPanel>
                          </Button>
                          <PathIcon DockPanel.Dock="Left" Classes.danger="{Binding IsActive}" Classes.muted="{Binding !IsActive}"
                                    Data="{StaticResource Icon.Prohibited}" Margin="0,2,12,0" VerticalAlignment="Top" />
                          <StackPanel Spacing="6">
                            <WrapPanel ItemSpacing="8">
                              <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" Foreground="{DynamicResource Ovs.Text}" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding ShortFingerprint}" FontFamily="Cascadia Mono,Consolas,monospace"
                                         VerticalAlignment="Center" ToolTip.Tip="{Binding Fingerprint}" />
                            </WrapPanel>
                            <TextBlock Classes="caption" Classes.danger="{Binding IsActive}" Text="{Binding StatusText}" TextWrapping="Wrap" />
                            <!-- two or more columns when wide, one under narrow -->
                            <WrapPanel Classes="userDetails" ItemSpacing="16" LineSpacing="6">
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanReasonLabel}" />
                                <TextBlock Classes="body" Text="{Binding ReasonText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel IsVisible="{Binding HasIp}">
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanIp}" />
                                <TextBlock Classes="body" Text="{Binding Ip}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanCreatedBy}" />
                                <TextBlock Classes="body" Text="{Binding CreatedBy}" TextWrapping="Wrap" ToolTip.Tip="{Binding CreatedByFingerprintText}" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanCreatedAt}" />
                                <TextBlock Classes="body" Text="{Binding CreatedAtText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanDuration}" />
                                <TextBlock Classes="body" Text="{Binding DurationText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanEnd}" />
                                <TextBlock Classes="body" Text="{Binding EndText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel IsVisible="{Binding HasRemaining}">
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanRemaining}" />
                                <TextBlock Classes="body" Text="{Binding RemainingText}" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BanAttempts}" />
                                <TextBlock Classes="body" Text="{Binding AttemptsText}" TextWrapping="Wrap" />
                              </StackPanel>
                            </WrapPanel>
                            <StackPanel>
                              <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_IdentityFingerprint}" />
                              <SelectableTextBlock Classes="caption" Text="{Binding Fingerprint}" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono,Consolas,monospace" />
                            </StackPanel>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </TabItem>

        <!-- ===== Server ===== -->
        <!-- ===== Links (Package 38) ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Links}" IsVisible="{Binding ShowLinks}">
          <DockPanel DataContext="{Binding Links}" x:DataType="vm:LinkMatrixViewModel">
            <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{x:Static l:Strings.Ui_LinksHelp}" />
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0" ItemSpacing="8" LineSpacing="8">
              <Button Command="{Binding LinkSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.Link}" />
                  <TextBlock Text="{x:Static l:Strings.Ui_LinkSelected}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding UnlinkSelectedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.LinkDismiss}" />
                  <TextBlock Text="{x:Static l:Strings.Ui_UnlinkSelected}" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding ApplyCommand}" IsEnabled="{Binding HasPending}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.Checkmark}" />
                  <TextBlock Text="{x:Static l:Strings.Ui_Apply}" />
                </StackPanel>
              </Button>
              <Button Classes="subtle" Command="{Binding DiscardCommand}" IsEnabled="{Binding HasPending}" Content="{x:Static l:Strings.Ui_Discard}" />
              <TextBlock Classes="caption" Text="{Binding PendingText}" VerticalAlignment="Center" />
            </WrapPanel>
            <!-- Package 78: the whole matrix scrolls up and down, only the cells sideways; the row titles stay put -->
            <Border Classes="card" Padding="8">
              <ScrollViewer>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left">
                    <Border Classes="linkHeader" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkRowViewModel">
                          <StackPanel Orientation="Horizontal" Height="32">
                            <CheckBox IsChecked="{Binding IsSelected}" Width="36" MinWidth="36"
                                      AutomationProperties.Name="{Binding Name, StringFormat={x:Static l:Strings.Ui_SelectFmt}}" />
                            <TextBlock Classes="linkTitle" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Ovs.Text}" ToolTip.Tip="{Binding Name}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <ScrollViewer x:Name="LinkCells" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <!-- column numbers -->
                      <ItemsControl Classes="linkHeader" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LinkRowViewModel">
                            <TextBlock Classes="caption" Width="34" TextAlignment="Center" VerticalAlignment="Bottom"
                                       Text="{Binding Number}" ToolTip.Tip="{Binding Name}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LinkRowViewModel">
                            <ItemsControl ItemsSource="{Binding Cells}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinkCellViewModel">
                                  <Border Classes="linkCell" Classes.pending="{Binding IsPending}" ToolTip.Tip="{Binding Tooltip}">
                                    <CheckBox IsChecked="{Binding IsLinked}" IsVisible="{Binding !IsDiagonal}" MinWidth="0" Padding="0"
                                              HorizontalAlignment="Center" AutomationProperties.Name="{Binding Tooltip, StringFormat={x:Static l:Strings.Ui_LinkFmt}}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </TabItem>

        <TabItem Header="{x:Static l:Strings.Ui_Server}" IsVisible="{Binding ShowServer}">
          <ScrollViewer>
            <!-- Package 74: both cards share one width. Package 89: settings with ServerConfig, backups with BackupsManage -->
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
              <Border Classes="card" IsVisible="{Binding ShowServerSettings}">
                <StackPanel Spacing="12">
                  <!-- Server logo (Package 30): pick a file or drop it onto the preview -->
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_ServerLogo}" />
                    <DockPanel>
                      <Border x:Name="IconDrop" DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="16" ClipToBounds="True"
                              BorderThickness="1" BorderBrush="{DynamicResource Ovs.Border}" Background="{DynamicResource Ovs.SurfaceHover}"
                              DragDrop.AllowDrop="True" ToolTip.Tip="{x:Static l:Strings.Ui_DropImage}">
                        <Panel>
                          <PathIcon Classes="muted" Data="{StaticResource Icon.Add}" IsVisible="{Binding IconPng, Converter={x:Static ObjectConverters.IsNull}}" />
                          <Image Source="{Binding IconPng, Converter={x:Static v:Ui.PngToBitmap}}" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <StackPanel Margin="14,0,0,0" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_LogoHint}" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                          <Button Click="OnPickIcon">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Classes="sm" Data="{StaticResource Icon.Edit}" />
                              <TextBlock Text="{x:Static l:Strings.Ui_ChooseLogo}" />
                            </StackPanel>
                          </Button>
                          <Button Classes="subtle" Command="{Binding RemoveIconCommand}" IsVisible="{Binding HasIcon}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                              <TextBlock Text="{x:Static l:Strings.Ui_RemoveLogo}" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Classes="danger" Text="{Binding IconError}" TextWrapping="Wrap"
                               IsVisible="{Binding IconError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <Border Classes="divider" />

                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_ServerName}" />
                    <TextBox Text="{Binding ServerName}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_WelcomeText}" />
                    <TextBox Text="{Binding WelcomeText}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                    <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_WelcomeHint}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{x:Static l:Strings.Dlg_ServerPassword}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm muted" Data="{StaticResource Icon.LockClosed}" />
                      <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_HasPassword}" IsVisible="{Binding HasPassword}" />
                      <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_NoPassword}" IsVisible="{Binding !HasPassword}" />
                    </StackPanel>
                    <TextBox Text="{Binding NewPassword}" PasswordChar="•" Watermark="{x:Static l:Strings.Ui_NewPassword}" />
                    <CheckBox Content="{x:Static l:Strings.Ui_RemovePassword}" IsChecked="{Binding RemovePassword}" />
                  </StackPanel>
                  <Border Classes="divider" />

                  <!-- Package 69: formerly environment variables, applied at once -->
                  <StackPanel Spacing="12" IsEnabled="{Binding HasLimits}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Operation}" />
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_OperationHint}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_MaxUsers}" />
                      <NumericUpDown x:Name="MaxUsersInput" Value="{Binding MaxUsers}" Minimum="1" Maximum="100000" Increment="1" FormatString="0"
                                     Width="160" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static l:Strings.Ui_MaxUsers}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_LogDays}" />
                      <NumericUpDown x:Name="LogDaysInput" Value="{Binding LogDays}" Minimum="0" Maximum="3650" Increment="1" FormatString="0"
                                     Width="160" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static l:Strings.Ui_LogDays}" />
                    </StackPanel>
                    <CheckBox x:Name="LogRotateDailyInput" IsChecked="{Binding LogRotateDaily}">
                      <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_LogRotateDaily}" />
                    </CheckBox>
                    <StackPanel Spacing="4">
                      <CheckBox x:Name="AutoRestartInput" IsChecked="{Binding AutoRestart}">
                        <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_AutoRestart}" />
                      </CheckBox>
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_AutoRestartTime}" />
                      <TimePicker x:Name="AutoRestartTimeInput" SelectedTime="{Binding AutoRestartTime}" ClockIdentifier="24HourClock"
                                  IsEnabled="{Binding AutoRestart}" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{x:Static l:Strings.Ui_AutoRestartTime}" />
                    </StackPanel>
                  </StackPanel>
                  <Button Classes="accent" Command="{Binding SaveServerSettingsCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sm" Data="{StaticResource Icon.Checkmark}" />
                      <TextBlock Text="{x:Static l:Strings.Ui_SaveServerSettings}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <!-- Package 74: backups on the server, restored after a red question -->
              <Border Classes="card" IsVisible="{Binding ShowBackups}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Backups}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_BackupsHint}" />
                  <!-- Package 75: upload from this PC, optionally restored right away (after the same red question) -->
                  <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <Button Command="{Binding NewBackupCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Classes="sm" Data="{StaticResource Icon.Add}" />
                        <TextBlock Text="{x:Static l:Strings.Ui_CreateBackup}" />
                      </StackPanel>
                    </Button>
                    <!-- Package 89 (A101): upload and restore only for members of the Admin group -->
                    <Button Name="UploadBackupButton" Click="OnUploadBackup" IsEnabled="{Binding !IsTransferring}" IsVisible="{Binding CanUploadRestore}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowUp}" />
                        <TextBlock Text="{x:Static l:Strings.Ui_UploadBackup}" />
                      </StackPanel>
                    </Button>
                    <Button Name="UploadRestoreButton" Classes="danger" Click="OnUploadBackup" IsEnabled="{Binding !IsTransferring}" IsVisible="{Binding CanUploadRestore}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
                        <TextBlock Text="{x:Static l:Strings.Ui_UploadAndRestore}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <StackPanel Name="BackupTransfer" Spacing="4" IsVisible="{Binding IsTransferring}">
                    <TextBlock Classes="caption" Text="{Binding TransferText}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding TransferPercent}" Height="8" CornerRadius="4" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NoBackups}" IsVisible="{Binding HasNoBackups}" />
                  <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BackupViewModel">
                        <Border Classes="soundRow">
                          <StackPanel Spacing="6">
                            <StackPanel>
                              <TextBlock Classes="body" Text="{Binding Title}" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding Details}" TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                              <Button Click="OnDownloadBackup">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowDown}" />
                                  <TextBlock Text="{x:Static l:Strings.Ui_Download}" />
                                </StackPanel>
                              </Button>
                              <Button Classes="danger" Command="{Binding RestoreCommand}" IsVisible="{Binding CanRestore}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
                                  <TextBlock Text="{x:Static l:Strings.Ui_Restore}" />
                                </StackPanel>
                              </Button>
                              <Button Classes="subtle" Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                                  <TextBlock Text="{x:Static l:Strings.Ui_Delete}" />
                                </StackPanel>
                              </Button>
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ===== Logs (Package 81, A98: server and channel logs, page by page, search over all files) ===== -->
        <TabItem Header="{x:Static l:Strings.Ui_Logs}" IsVisible="{Binding ShowLogs}">
          <DockPanel DataContext="{Binding Logs}" x:DataType="vm:LogsViewModel" Classes="logsPage" Classes.fileOpen="{Binding IsFileOpen}">
            <StackPanel DockPanel.Dock="Top" Classes="logFilters" Spacing="8" Margin="0,0,0,12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding SearchCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.Search}" />
                    <TextBlock Text="{x:Static l:Strings.Ui_Search}" />
                  </StackPanel>
                </Button>
                <TextBox x:Name="LogSearch" Text="{Binding SearchText}" Watermark="{x:Static l:Strings.Ui_LogSearch}"
                         AutomationProperties.Name="{x:Static l:Strings.Ui_LogSearch}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </DockPanel>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <ComboBox x:Name="LogSourceFilter" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                          MinWidth="140" AutomationProperties.Name="{x:Static l:Strings.Ui_LogSourceFilter}" />
                <CalendarDatePicker x:Name="LogFrom" SelectedDate="{Binding FromDate}" Watermark="{x:Static l:Strings.Ui_LogFrom}"
                                    Width="150" AutomationProperties.Name="{x:Static l:Strings.Ui_LogFrom}" />
                <CalendarDatePicker x:Name="LogTo" SelectedDate="{Binding ToDate}" Watermark="{x:Static l:Strings.Ui_LogTo}"
                                    Width="150" AutomationProperties.Name="{x:Static l:Strings.Ui_LogTo}" />
              </WrapPanel>
              <TextBlock Classes="caption" Text="{Binding FileCountText}" TextWrapping="Wrap" />
              <!-- Package 82: with LogsDownload, the checked files as one .log or a zip; the progress is the page's transfer -->
              <WrapPanel Name="LogDownloadBar" ItemSpacing="8" LineSpacing="6" IsVisible="{Binding ShowDownload}">
                <Button Command="{Binding SelectAllInPeriodCommand}">
                  <TextBlock Text="{x:Static l:Strings.Ui_LogSelectAll}" />
                </Button>
                <Button Classes="subtle" Command="{Binding SelectNoneCommand}">
                  <TextBlock Text="{x:Static l:Strings.Ui_LogSelectNone}" />
                </Button>
                <Button Name="LogDownloadButton" Click="OnDownloadLogs" IsEnabled="{Binding CanDownload}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowDown}" />
                    <TextBlock Text="{x:Static l:Strings.Ui_Download}" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="caption" Text="{Binding SelectionText}" VerticalAlignment="Center" />
              </WrapPanel>
              <StackPanel Name="LogTransfer" Spacing="4" IsVisible="{Binding Owner.IsTransferring}">
                <TextBlock Classes="caption" Text="{Binding Owner.TransferText}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Owner.TransferPercent}" Height="8" CornerRadius="4" />
              </StackPanel>
            </StackPanel>
            <!-- file list (or the hits of a search) beside the opened file; under narrow one after the other (styles in Controls.axaml) -->
            <Grid Classes="adminLogs" ColumnDefinitions="Auto,*" RowDefinitions="2*,3*">
              <Border Classes="card logList" Padding="6">
                <Panel>
                  <Panel IsVisible="{Binding !ShowHits}">
                    <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NoLogs}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" IsVisible="{Binding HasNoFiles}" />
                    <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NoLogMatches}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" IsVisible="{Binding HasNoFileMatches}" />
                    <ListBox x:Name="LogFileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogFileViewModel">
                          <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsVisible="{Binding CanSelect}" MinWidth="0"
                                      Margin="0,0,4,0" VerticalAlignment="Top" AutomationProperties.Name="{x:Static l:Strings.Ui_LogSelectFile}" />
                            <PathIcon DockPanel.Dock="Left" Classes="sm muted" Margin="0,2,8,0" VerticalAlignment="Top"
                                      Data="{StaticResource Icon.Document}" IsVisible="{Binding IsServer}" />
                            <PathIcon DockPanel.Dock="Left" Classes="sm muted" Margin="0,2,8,0" VerticalAlignment="Top"
                                      Data="{StaticResource Icon.Chat}" IsVisible="{Binding !IsServer}" />
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding Details}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Panel>
                  <DockPanel IsVisible="{Binding ShowHits}">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="4,2,4,6">
                      <Button Classes="subtle" Command="{Binding ClearSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.Dismiss}" />
                          <TextBlock Text="{x:Static l:Strings.Ui_LogBackToFiles}" />
                        </StackPanel>
                      </Button>
                      <TextBlock Name="LogHitsText" Classes="caption" Text="{Binding HitsText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="LogHitList" ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}" Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogHitViewModel">
                          <StackPanel>
                            <WrapPanel ItemSpacing="8">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding LineText}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Classes="caption logText" Text="{Binding Text}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Panel>
              </Border>
              <Border Classes="card logViewer" Padding="12,10">
                <Panel>
                  <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_LogChooseFile}" TextWrapping="Wrap" TextAlignment="Center"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsFileOpen}" />
                  <DockPanel IsVisible="{Binding IsFileOpen}">
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseFileCommand}"
                                ToolTip.Tip="{x:Static l:Strings.Ui_LogCloseFile}" AutomationProperties.Name="{x:Static l:Strings.Ui_LogCloseFile}">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.Dismiss}" />
                        </Button>
                        <TextBlock Text="{Binding OpenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                      <WrapPanel Name="LogPager" ItemSpacing="6" LineSpacing="6">
                        <Button Classes="icon" Command="{Binding FirstCommand}" ToolTip.Tip="{x:Static l:Strings.Ui_LogFirst}"
                                AutomationProperties.Name="{x:Static l:Strings.Ui_LogFirst}">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowUp}" />
                        </Button>
                        <Button Command="{Binding OlderCommand}">
                          <TextBlock Text="{x:Static l:Strings.Ui_LogOlder}" />
                        </Button>
                        <TextBlock Classes="caption" Text="{Binding PageText}" VerticalAlignment="Center" />
                        <Button Command="{Binding NewerCommand}">
                          <TextBlock Text="{x:Static l:Strings.Ui_LogNewer}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding LastCommand}" ToolTip.Tip="{x:Static l:Strings.Ui_LogLast}"
                                AutomationProperties.Name="{x:Static l:Strings.Ui_LogLast}">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowDown}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding ReloadCommand}" ToolTip.Tip="{x:Static l:Strings.Ui_LogReload}"
                                AutomationProperties.Name="{x:Static l:Strings.Ui_LogReload}">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
                        </Button>
                      </WrapPanel>
                      <TextBox x:Name="LogLineFilter" Text="{Binding LineFilter}" Watermark="{x:Static l:Strings.Ui_LogLineFilter}"
                               AutomationProperties.Name="{x:Static l:Strings.Ui_LogLineFilter}" />
                    </StackPanel>
                    <Panel>
                      <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_LogNoLines}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TextWrapping="Wrap" IsVisible="{Binding !HasLines}" />
                      <!-- long lines wrap; the selected line is the one a search hit opened -->
                      <ListBox x:Name="LogLines" Classes="logLines" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Background="Transparent">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:LogLineViewModel">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Left" Classes="caption logText" Text="{Binding Number}" Width="52" Margin="0,0,8,0" TextAlignment="Right" />
                              <TextBlock Classes="logText" Inlines="{Binding Segments, Converter={x:Static v:Ui.LogSegments}}" TextWrapping="Wrap" />
                            </DockPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Panel>
                  </DockPanel>
                </Panel>
              </Border>
            </Grid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</UserControl>
