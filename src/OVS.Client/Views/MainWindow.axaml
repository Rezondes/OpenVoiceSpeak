<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:OVS.Client.Localization"
        xmlns:vm="using:OVS.Client.ViewModels"
        xmlns:s="using:OVS.Client.Settings"
        xmlns:v="using:OVS.Client.Views"
        x:Class="OVS.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OpenVoiceSpeak" Width="1100" Height="700" MinWidth="360" MinHeight="480"
        Background="{DynamicResource Ovs.Bg}" Icon="/Assets/ovs.ico"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <!-- Package 68 (A94): below 700 px the sidebar leaves its column and slides in over the left edge -->
    <Style Selector="Window.compact Border#Sidebar">
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ZIndex" Value="1" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact.drawer Border#Sidebar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window:not(.drawer) Border#DrawerScrim">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact GridSplitter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>

  <!-- Maximized, Windows hides a border off screen: OffScreenMargin keeps the content inside. -->
  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">
  <v:TitleBar DockPanel.Dock="Top" />
  <!-- Package 67: the sidebar width is fitted to the channel names on connect (MainWindow.axaml.cs);
       Package 68: bounded so the header always fits, below 700 px a drawer -->
  <Grid x:Name="Shell" ColumnDefinitions="300,Auto,*">
    <!-- ================= Sidebar: server, channels, own user ================= -->
    <Border x:Name="Sidebar" Grid.Column="0" IsEnabled="{Binding !IsUpdating}" Background="{DynamicResource Ovs.Sidebar}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <!-- Server header -->
        <Border DockPanel.Dock="Top" Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ovs.Border}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding Server.NewChannelCommand, FallbackValue={x:Null}}"
                    IsVisible="{Binding Server.CanCreateChannel, FallbackValue=False}"
                    ToolTip.Tip="{x:Static l:Strings.Dialog_CreateChannel}" AutomationProperties.Name="{x:Static l:Strings.Dialog_CreateChannel}">
              <PathIcon Data="{StaticResource Icon.Add}" />
            </Button>
            <!-- Server logo (Package 30), otherwise the first letter of the server name -->
            <Panel DockPanel.Dock="Left">
              <Border Classes="badge" IsVisible="{Binding Server.IconPng, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}">
                <TextBlock Text="{Binding Server.ServerName, Converter={x:Static v:Ui.Initials}, FallbackValue='O'}" />
              </Border>
              <Border Classes="badge" ClipToBounds="True" Background="Transparent"
                      IsVisible="{Binding Server.IconPng, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <Image Source="{Binding Server.IconPng, Converter={x:Static v:Ui.PngToBitmap}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
              </Border>
            </Panel>
            <StackPanel Margin="10,0,4,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h2" Text="{Binding Server.ServerName, FallbackValue='OpenVoiceSpeak'}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot" Classes.online="{Binding IsConnected}" VerticalAlignment="Center" />
                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_Connected}" IsVisible="{Binding IsConnected}" />
                <TextBlock Classes="caption" Text="{x:Static l:Strings.Status_NotConnected}" IsVisible="{Binding !IsConnected}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Own user and quick controls -->
        <Border DockPanel.Dock="Bottom" Padding="10,8" Background="{DynamicResource Ovs.SidebarFooter}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ovs.Border}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <ToggleButton Classes="icon" IsChecked="{Binding Server.SelfMuted, Mode=OneWay, FallbackValue=False}"
                            Command="{Binding Server.ToggleMuteCommand, FallbackValue={x:Null}}" IsEnabled="{Binding IsConnected}"
                            ToolTip.Tip="{x:Static l:Strings.Ui_MuteMic}" AutomationProperties.Name="{x:Static l:Strings.Ui_MuteMic}">
                <Panel>
                  <PathIcon Data="{StaticResource Icon.Mic}" IsVisible="{Binding !Server.SelfMuted, FallbackValue=True}" />
                  <PathIcon Data="{StaticResource Icon.MicOff}" IsVisible="{Binding Server.SelfMuted, FallbackValue=False}" />
                </Panel>
              </ToggleButton>
              <ToggleButton Classes="icon" IsChecked="{Binding Server.SelfDeafened, Mode=OneWay, FallbackValue=False}"
                            Command="{Binding Server.ToggleDeafenCommand, FallbackValue={x:Null}}" IsEnabled="{Binding IsConnected}"
                            ToolTip.Tip="{x:Static l:Strings.Ui_DeafenTip}" AutomationProperties.Name="{x:Static l:Strings.Ui_Deafen}">
                <Panel>
                  <PathIcon Data="{StaticResource Icon.Headphones}" IsVisible="{Binding !Server.SelfDeafened, FallbackValue=True}" />
                  <PathIcon Data="{StaticResource Icon.SpeakerOff}" IsVisible="{Binding Server.SelfDeafened, FallbackValue=False}" />
                </Panel>
              </ToggleButton>
              <Button Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{x:Static l:Strings.Ui_Settings}" AutomationProperties.Name="{x:Static l:Strings.Ui_Settings}">
                <PathIcon Classes="spin" Data="{StaticResource Icon.Settings}" />
              </Button>
            </StackPanel>
            <Border Classes="ring" Classes.speaking="{Binding Server.Self.IsSpeaking, FallbackValue=False}"
                    Classes.link="{Binding Server.Self.IsSpeakingViaLink, FallbackValue=False}" VerticalAlignment="Center"
                    IsVisible="{Binding IsConnected}">
              <Border Classes="avatar" Width="30" Height="30"
                      Background="{Binding Server.Self.Nickname, Converter={x:Static v:Ui.AvatarBrush}, FallbackValue={x:Null}}">
                <TextBlock Text="{Binding Server.Self.Nickname, Converter={x:Static v:Ui.Initials}, FallbackValue='?'}" FontSize="13" />
              </Border>
            </Border>
            <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
              <TextBlock Classes="h2" FontSize="14" Text="{Binding Server.Self.Nickname, FallbackValue={x:Static l:Strings.Status_NotConnected}}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption speaking" Text="{Binding TransmitText}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding TransmitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Panel IsVisible="{Binding TransmitText, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                <TextBlock Classes="caption" Text="{Binding TalkHint}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasNoPttBinding}" />
                <!-- Without a PTT key nobody can talk: the hint leads straight to the settings. -->
                <Button Classes="hint" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding HasNoPttBinding}"
                        ToolTip.Tip="{x:Static l:Strings.Ui_AssignKeyHint}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Classes="sm warning" Data="{StaticResource Icon.Warning}" />
                    <TextBlock Classes="caption warning" Text="{Binding TalkHint}" />
                  </StackPanel>
                </Button>
              </Panel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Channel tree -->
        <Panel>
          <!-- Not connected: the bookmarks (Package 40) -->
          <ScrollViewer Padding="8,10" IsVisible="{Binding !IsConnected}">
            <StackPanel Spacing="2">
              <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_BookmarksSection}" Margin="10,4,0,6" />
              <TextBlock Classes="caption" Margin="10,0" TextWrapping="Wrap" IsVisible="{Binding !HasBookmarks}"
                         Text="{x:Static l:Strings.Ui_NoBookmarks}" />
              <ItemsControl ItemsSource="{Binding Bookmarks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BookmarkItem">
                    <Button Classes="bookmark" Click="OnBookmarkClick" ToolTip.Tip="{Binding Address}"
                            AutomationProperties.Name="{Binding Name, StringFormat={x:Static l:Strings.Ui_ConnectToFmt}}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{x:Static l:Strings.Dlg_Connect}" Click="OnBookmarkClick">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.PlugConnected}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_EditMenu}" Click="OnBookmarkEdit">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Edit}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="{x:Static l:Strings.Ui_DeleteMenu}" Click="OnBookmarkDelete">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Delete}" Classes="sm danger" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Button.ContextMenu>
                      <DockPanel>
                        <PathIcon DockPanel.Dock="Right" Classes="sm muted" Data="{StaticResource Icon.LockClosed}"
                                  IsVisible="{Binding HasSavedPassword}" ToolTip.Tip="{x:Static l:Strings.Ui_PasswordSaved}" />
                        <Panel DockPanel.Dock="Left">
                          <Border Classes="badge" Width="28" Height="28" CornerRadius="7"
                                  IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="{Binding Name, Converter={x:Static v:Ui.Initials}}" FontSize="13" />
                          </Border>
                          <Border Classes="badge" Width="28" Height="28" CornerRadius="7" ClipToBounds="True" Background="Transparent"
                                  IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Source="{Binding Icon, Converter={x:Static v:Ui.PngToBitmap}}" Stretch="UniformToFill" />
                          </Border>
                        </Panel>
                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Ovs.Text}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Nickname, StringFormat={x:Static l:Strings.Ui_AsFmt}}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer Padding="8,10" IsVisible="{Binding IsConnected}">
            <ItemsControl x:Name="ChannelItems" ItemsSource="{Binding Server.Channels, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelViewModel">
                  <StackPanel Margin="0,0,0,4">
                    <Border Classes="row" Classes.current="{Binding IsCurrent}" DoubleTapped="OnChannelDoubleTapped"
                            ToolTip.Tip="{Binding Tooltip}">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{x:Static l:Strings.Ui_Join}" Command="{Binding JoinCommand}" IsEnabled="{Binding CanJoin}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.DoorArrowRight}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_CreateChannelMenu}" Command="{Binding CreateCommand}" IsVisible="{Binding CanCreate}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Add}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_EditMenu}" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Edit}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_MoveUp}" Command="{Binding MoveUpCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding CanMoveUp}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ArrowUp}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_MoveDown}" Command="{Binding MoveDownCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding CanMoveDown}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ArrowDown}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_LinkWithMenu}" Command="{Binding LinkCommand}" IsVisible="{Binding CanLink}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Link}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static l:Strings.Ui_UnlinkMenu}" Command="{Binding UnlinkCommand}" IsVisible="{Binding CanUnlink}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.LinkDismiss}" Classes="sm" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator IsVisible="{Binding CanDelete}" />
                          <MenuItem Header="{x:Static l:Strings.Ui_DeleteMenu}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Delete}" Classes="sm danger" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="caption channelCount" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="{Binding SlotText}" ToolTip.Tip="{x:Static l:Strings.Ui_UsersInChannel}" />
                        <!-- Package 98: joining, moving or deleting waits for the server -->
                        <v:BusySpinner DockPanel.Dock="Right" Margin="8,0,0,0" IsVisible="{Binding IsBusy}" />
                        <!-- Package 66: a muted channel shows the mute icon in front instead of the speaker -->
                        <Panel DockPanel.Dock="Left" Margin="0,0,8,0">
                          <PathIcon Classes="muted channelIcon" Data="{StaticResource Icon.Speaker}" IsVisible="{Binding !IsMuted}" />
                          <PathIcon Classes="warning channelIcon" Data="{StaticResource Icon.MicOff}" IsVisible="{Binding IsMuted}"
                                    ToolTip.Tip="{x:Static l:Strings.Dlg_MutedChannel}" />
                        </Panel>
                        <!-- Package 67: left-aligned, so home and link icon follow the name and the name trims when space runs out -->
                        <DockPanel HorizontalAlignment="Left">
                          <!-- Package 93: the lock names who may join -->
                          <PathIcon DockPanel.Dock="Right" Classes="sm muted" Data="{StaticResource Icon.LockClosed}" IsVisible="{Binding IsLocked}"
                                    ToolTip.Tip="{Binding LockText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                          <PathIcon DockPanel.Dock="Right" Classes="sm link" Data="{StaticResource Icon.Link}" IsVisible="{Binding IsLinked}"
                                    ToolTip.Tip="{Binding LinkedNames, StringFormat={x:Static l:Strings.Ui_LinkedWithFmt}}"
                                    Margin="6,0,0,0" VerticalAlignment="Center" />
                          <PathIcon DockPanel.Dock="Right" Classes="sm muted" Data="{StaticResource Icon.Home}" IsVisible="{Binding IsDefault}"
                                    ToolTip.Tip="{x:Static l:Strings.Ui_DefaultChannel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Classes="channelName" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ovs.Text}" />
                        </DockPanel>
                      </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Users}" Margin="18,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UserViewModel">
                          <Border Classes="row" Padding="6,3" ToolTip.Tip="{Binding GroupNames}">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <!-- Package 51: this person's volume for me; the menu stays open while dragging -->
                                <MenuItem StaysOpenOnClick="True" IsVisible="{Binding CanAdjustVolume}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Speaker}" Classes="sm" /></MenuItem.Icon>
                                  <MenuItem.Header>
                                    <StackPanel MinWidth="200" Spacing="2">
                                      <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding VolumePercent, StringFormat='{}{0:0} %'}" />
                                        <TextBlock Text="{x:Static l:Strings.Ui_Volume}" />
                                      </DockPanel>
                                      <Slider Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                              Value="{Binding VolumePercent}" AutomationProperties.Name="{Binding VolumeLabel}" />
                                    </StackPanel>
                                  </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="{x:Static l:Strings.Ui_UserVolumeReset}" Command="{Binding ResetVolumeCommand}" IsVisible="{Binding CanAdjustVolume}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ArrowSync}" Classes="sm" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator IsVisible="{Binding CanAdjustVolume}" />
                                <MenuItem Header="{x:Static l:Strings.Ui_PrivateMessage}" Command="{Binding MessageCommand}" IsVisible="{Binding CanMessage}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Chat}" Classes="sm" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static l:Strings.Ui_MoveMenu}" Command="{Binding MoveCommand}" IsVisible="{Binding CanMove}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ArrowMove}" Classes="sm" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static l:Strings.Ui_ServerMuteMenu}" Command="{Binding ToggleServerMuteCommand}" IsVisible="{Binding CanMute}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.SpeakerMute}" Classes="sm" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static l:Strings.Ui_KickMenu}" Command="{Binding KickCommand}" IsVisible="{Binding CanKick}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.PersonDelete}" Classes="sm danger" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static l:Strings.Ui_BanMenu}" Command="{Binding BanCommand}" IsVisible="{Binding CanBan}">
                                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Prohibited}" Classes="sm danger" /></MenuItem.Icon>
                                </MenuItem>
                              </ContextMenu>
                            </Border.ContextMenu>
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <v:BusySpinner IsVisible="{Binding IsBusy}" /> <!-- Package 98: the server mute waits for the server -->
                                <PathIcon Classes="sm link" Data="{StaticResource Icon.Link}" IsVisible="{Binding IsSpeakingViaLink}"
                                          ToolTip.Tip="{x:Static l:Strings.Ui_TalkingViaLink}" />
                                <PathIcon Classes="sm muted" Data="{StaticResource Icon.Speaker}" IsVisible="{Binding IsVolumeChanged}"
                                          ToolTip.Tip="{Binding VolumeText}" />
                                <PathIcon Classes="sm muted" Data="{StaticResource Icon.SpeakerOff}" IsVisible="{Binding IsLocallyMuted}"
                                          ToolTip.Tip="{Binding VolumeText}" />
                                <PathIcon Classes="sm danger" Data="{StaticResource Icon.SpeakerMute}" IsVisible="{Binding ServerMuted}"
                                          ToolTip.Tip="{x:Static l:Strings.Ui_ServerMuted}" />
                                <PathIcon Classes="sm muted" Data="{StaticResource Icon.SpeakerOff}" IsVisible="{Binding IsDeafened}"
                                          ToolTip.Tip="{x:Static l:Strings.Ui_Deafen}" />
                                <PathIcon Classes="sm muted" Data="{StaticResource Icon.MicOff}" IsVisible="{Binding IsSelfMutedOnly}"
                                          ToolTip.Tip="{x:Static l:Strings.Ui_Muted}" />
                              </StackPanel>
                              <Border Classes="ring" Classes.speaking="{Binding IsSpeaking}" Classes.link="{Binding IsSpeakingViaLink}">
                                <Border Classes="avatar" Width="24" Height="24" Background="{Binding Nickname, Converter={x:Static v:Ui.AvatarBrush}}">
                                  <TextBlock Text="{Binding Nickname, Converter={x:Static v:Ui.Initials}}" FontSize="11" />
                                </Border>
                              </Border>
                              <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ovs.Text}"
                                           FontWeight="{Binding IsSelf, Converter={x:Static v:Ui.SelfWeight}}" />
                                <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_You}" IsVisible="{Binding IsSelf}" VerticalAlignment="Center" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" DragCompleted="OnSidebarDragCompleted" />

    <!-- ================= Main area: home, settings or administration, all inside this window (A20) ================= -->
    <Panel Grid.Column="2" IsEnabled="{Binding !IsUpdating}">
      <Panel IsVisible="{Binding IsHomePage}">
        <!-- Start screen while not connected -->
        <Panel IsVisible="{Binding !IsConnected}">
        <ScrollViewer>
          <StackPanel Classes="startScreen" MaxWidth="460" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <v:LogoMark Width="80" Height="80" HorizontalAlignment="Center" />
            <TextBlock Classes="h1" Text="OpenVoiceSpeak" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsConnecting}" Width="220" />
            <Button Classes="accent" HorizontalAlignment="Center" Click="OnConnectClick" IsEnabled="{Binding !IsConnecting}"
                    Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.PlugConnected}" />
                <TextBlock Text="{x:Static l:Strings.Ui_ConnectMenu}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <Button Classes="icon compactOnly" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnDrawerToggle"
                ToolTip.Tip="{x:Static l:Strings.Ui_ShowChannels}" AutomationProperties.Name="{x:Static l:Strings.Ui_ShowChannels}">
          <PathIcon Data="{StaticResource Icon.Navigation}" />
        </Button>
        </Panel>

        <!-- Connected: channel header and chat -->
        <DockPanel IsVisible="{Binding IsConnected}">
          <!-- Package 68 (A82, A95): never clipped; the sidebar yields to it, under narrow the buttons show only their icon -->
          <Border x:Name="ChannelHeader" DockPanel.Dock="Top" Padding="20,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ovs.Border}">
            <DockPanel>
              <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="PingChip" Classes="chip" IsVisible="{Binding PingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <ToolTip.Tip>
                    <StackPanel>
                      <TextBlock Text="{x:Static l:Strings.Ui_PingTip}" />
                      <TextBlock Text="{Binding PingText}" />
                    </StackPanel>
                  </ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Classes="sm muted" Data="{StaticResource Icon.WifiSignal}" />
                    <TextBlock Classes="wideOnly" Text="{Binding PingText}" />
                  </StackPanel>
                </Border>
                <Button Classes="subtle" Command="{Binding OpenAdminCommand}" IsVisible="{Binding Server.CanAdminister, FallbackValue=False}"
                        ToolTip.Tip="{x:Static l:Strings.Ui_AdminMenu}" AutomationProperties.Name="{x:Static l:Strings.Ui_AdminMenu}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.ShieldPerson}" />
                    <TextBlock Classes="wideOnly" Text="{x:Static l:Strings.Ui_AdminMenu}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="subtle" Command="{Binding Server.RedeemTokenCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding Server.CanRedeemToken, FallbackValue=False}"
                        ToolTip.Tip="{x:Static l:Strings.Ui_RedeemTokenMenu}" AutomationProperties.Name="{x:Static l:Strings.Ui_RedeemTokenMenu}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Key}" />
                    <TextBlock Classes="wideOnly" Text="{x:Static l:Strings.Ui_RedeemTokenMenu}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="danger" Command="{Binding DisconnectCommand}"
                        ToolTip.Tip="{x:Static l:Strings.Ui_Disconnect}" AutomationProperties.Name="{x:Static l:Strings.Ui_Disconnect}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.CallEnd}" />
                    <TextBlock Classes="wideOnly" Text="{x:Static l:Strings.Ui_Disconnect}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <Button DockPanel.Dock="Left" Classes="icon compactOnly" Margin="-8,0,4,0" Click="OnDrawerToggle"
                      ToolTip.Tip="{x:Static l:Strings.Ui_ShowChannels}" AutomationProperties.Name="{x:Static l:Strings.Ui_ShowChannels}">
                <PathIcon Data="{StaticResource Icon.Navigation}" />
              </Button>
              <PathIcon x:Name="VoiceIcon" DockPanel.Dock="Left" Classes="muted" Data="{StaticResource Icon.Speaker}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="{Binding Server.CurrentChannel.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding Server.CurrentChannel.Description, FallbackValue=''}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Server.CurrentChannel.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top" Classes="banner warning" Margin="20,12,20,0"
                  IsVisible="{Binding VoiceHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Classes="warning" Data="{StaticResource Icon.Warning}" />
              <TextBlock Classes="warning" Text="{Binding VoiceHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <v:ChatView DataContext="{Binding Chat}" />
        </DockPanel>
      </Panel>
      <Panel IsVisible="{Binding IsSettingsPage}">
        <v:SettingsView DataContext="{Binding SettingsPage}" />
      </Panel>
      <Panel IsVisible="{Binding IsAdminPage}">
        <v:AdminView DataContext="{Binding AdminPage}" />
      </Panel>
    </Panel>

    <!-- Package 68: dims the main area while the drawer is open; a click on it closes the drawer -->
    <Border x:Name="DrawerScrim" Grid.ColumnSpan="3" Background="{DynamicResource Ovs.Scrim}" PointerPressed="OnDrawerScrimPressed" />

    <!-- Dialogs: a modal layer over the whole window (above the drawer) -->
    <v:OverlayHost x:Name="OverlayLayer" Grid.ColumnSpan="3" ZIndex="2" />

    <!-- Package 62: update progress over everything below the title bar; the content under it is disabled meanwhile -->
    <Panel x:Name="UpdateLayer" Grid.ColumnSpan="3" ZIndex="2" IsVisible="{Binding IsUpdating}" Background="{DynamicResource Ovs.Scrim}">
      <!-- Package 79: 420 px where there is room, otherwise the window width less 16 px on each side -->
      <Border Classes="dialog" MaxWidth="420" Margin="16" Padding="24,20" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Classes="accent" Data="{StaticResource Icon.ArrowSync}" Margin="0,0,10,0" />
            <TextBlock Classes="h2" Text="{Binding UpdateInProgress.Title, FallbackValue=''}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
          <ProgressBar x:Name="UpdateBar" Minimum="0" Maximum="100" Height="8" CornerRadius="4"
                       Value="{Binding UpdateInProgress.Percent, FallbackValue=0}"
                       IsIndeterminate="{Binding UpdateInProgress.IsIndeterminate, FallbackValue=True}" />
          <TextBlock x:Name="UpdateDetail" Classes="caption" Text="{Binding UpdateInProgress.Detail, FallbackValue=''}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
  </DockPanel>
</Window>
