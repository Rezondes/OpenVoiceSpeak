<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OVS.Client.ViewModels"
        x:Class="OVS.Client.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Einstellungen" Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="Mikrofon" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioDeviceOption">
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="Lautsprecher" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioDeviceOption">
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding DeviceHint}" IsVisible="{Binding DeviceHint, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="OrangeRed" TextWrapping="Wrap" />

    <TextBlock Text="{Binding InputGainPercent, StringFormat='Mikrofonverstärkung: {0:0} %'}" />
    <Slider Minimum="0" Maximum="200" Value="{Binding InputGainPercent}" />
    <TextBlock Text="{Binding OutputVolumePercent, StringFormat='Lautstärke: {0:0} %'}" />
    <Slider Minimum="0" Maximum="100" Value="{Binding OutputVolumePercent}" />

    <CheckBox Content="Sprachaktivierung statt Push-to-Talk" IsChecked="{Binding VoiceActivation}" />
    <TextBlock Text="{Binding VadThresholdDb, StringFormat='Schwelle der Sprachaktivierung: {0:0} dBFS'}" />
    <Slider Minimum="-60" Maximum="-10" Value="{Binding VadThresholdDb}" />
    <TextBlock Text="{Binding InputLevelDb, StringFormat='Aktueller Mikrofonpegel: {0:0} dBFS'}" />
    <ProgressBar Minimum="-60" Maximum="0" Value="{Binding InputLevelDb}" Height="8" />

    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Push-to-Talk:" VerticalAlignment="Center" Margin="0,0,8,4" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PttKeyName}" VerticalAlignment="Center" FontWeight="SemiBold" />
      <Button Grid.Row="0" Grid.Column="2" Content="Ändern ..." Command="{Binding CapturePttKeyCommand}" Margin="0,0,0,4" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Link-PTT:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinkPttKeyName}" VerticalAlignment="Center" FontWeight="SemiBold" />
      <Button Grid.Row="1" Grid.Column="2" Content="Ändern ..." Command="{Binding CaptureLinkPttKeyCommand}" />
    </Grid>
    <TextBlock Text="{Binding CaptureHint}" Foreground="#3498DB" IsVisible="{Binding CaptureHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Text="{Binding Error}" Foreground="Red" IsVisible="{Binding HasKeyConflict}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Speichern" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" IsDefault="True" />
      <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
