<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OVS.Client.ViewModels"
             xmlns:l="using:OVS.Client.Localization"
             xmlns:v="using:OVS.Client.Views"
             x:Class="OVS.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel>
    <!-- Page header: title and close (Esc closes as well). Package 77: paddings and narrow layouts in Controls.axaml -->
    <Border DockPanel.Dock="Top" Classes="settingsHeader" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CancelCommand}"
                ToolTip.Tip="{x:Static l:Strings.Ui_CloseEsc}" AutomationProperties.Name="{x:Static l:Strings.Ui_CloseSettings}">
          <PathIcon Data="{StaticResource Icon.Dismiss}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Ovs.AccentSurface}">
            <PathIcon Classes="accent" Data="{StaticResource Icon.Settings}" />
          </Border>
          <TextBlock Classes="h2" FontSize="17" Text="{x:Static l:Strings.Ui_Settings}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Button bar -->
    <Border DockPanel.Dock="Bottom" Classes="settingsBar" Background="{DynamicResource Ovs.Sidebar}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static l:Strings.Dlg_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" HorizontalContentAlignment="Center" />
          <!-- Package 98: busy while the audio devices restart, the page closes afterwards -->
          <Button Name="SaveSettingsButton" Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                  MinWidth="96" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:BusySpinner IsVisible="{Binding Saving.IsBusy}" />
              <TextBlock Text="{x:Static l:Strings.Dlg_Save}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Classes="danger" Text="{Binding Error}" IsVisible="{Binding HasKeyConflict}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Classes="settingsBody" Spacing="20" MaxWidth="720" HorizontalAlignment="Stretch">

        <!-- Devices -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_DevicesSection}" />
          <Border Classes="card">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Microphone}" />
                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioDeviceOption">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Speaker}" />
                <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioDeviceOption">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Border Classes="banner warning" IsVisible="{Binding DeviceHint, Converter={x:Static ObjectConverters.IsNotNull}}">
                <DockPanel>
                  <PathIcon DockPanel.Dock="Left" Classes="warning" Data="{StaticResource Icon.Warning}" Margin="0,0,8,0" VerticalAlignment="Top" />
                  <TextBlock Classes="warning" Text="{Binding DeviceHint}" TextWrapping="Wrap" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Volume -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_VolumeSection}" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding InputGainPercent, StringFormat='{}{0:0} %'}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_MicGain}" />
              </DockPanel>
              <Slider Minimum="0" Maximum="200" Value="{Binding InputGainPercent}" AutomationProperties.Name="{x:Static l:Strings.Ui_MicGain}" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding OutputVolumePercent, StringFormat='{}{0:0} %'}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Volume}" />
              </DockPanel>
              <Slider Minimum="0" Maximum="200" Value="{Binding OutputVolumePercent}" AutomationProperties.Name="{x:Static l:Strings.Ui_Volume}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Transmit mode -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_TransmitSection}" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <RadioButton IsChecked="{Binding IsPushToTalk}">
                <TextBlock Text="{x:Static l:Strings.Ui_ModePtt}" TextWrapping="Wrap" />
              </RadioButton>
              <!-- Package 59: push-to-talk without a key cannot work -->
              <Border Classes="banner warning" IsVisible="{Binding ShowPttHint}" Margin="28,0,0,0">
                <DockPanel>
                  <PathIcon DockPanel.Dock="Left" Classes="warning" Data="{StaticResource Icon.Warning}" Margin="0,0,8,0" VerticalAlignment="Top" />
                  <Button Classes="pttKey" Content="{x:Static l:Strings.Ui_SetPttKey}" Command="{Binding SetPttKeyCommand}" />
                  <TextBlock Classes="warning" Text="{x:Static l:Strings.Ui_PttHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <RadioButton IsChecked="{Binding VoiceActivation}">
                <TextBlock Text="{x:Static l:Strings.Ui_ModeVad}" TextWrapping="Wrap" />
              </RadioButton>
              <StackPanel Spacing="6" IsVisible="{Binding VoiceActivation}" Margin="28,4,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding VadThresholdDb, StringFormat='{}{0:0} dBFS'}" />
                  <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Threshold}" />
                </DockPanel>
                <!-- Meter and threshold slider share one scale, so the slider thumb marks the threshold on the meter. -->
                <ProgressBar Minimum="-60" Maximum="-10" Value="{Binding InputLevelDb}" Height="8" Margin="10,0" CornerRadius="4" />
                <Slider Minimum="-60" Maximum="-10" Value="{Binding VadThresholdDb}" Margin="0,-6,0,0" AutomationProperties.Name="{x:Static l:Strings.Ui_ThresholdName}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="caption" Text="{Binding InputLevelDb, StringFormat={x:Static l:Strings.Ui_LevelFmt}}" />
                  <TextBlock Classes="caption speaking" Text="{x:Static l:Strings.Ui_AboveThreshold}" IsVisible="{Binding IsAboveThreshold}" />
                  <TextBlock Classes="caption" Text="{x:Static l:Strings.Ui_BelowThreshold}" IsVisible="{Binding !IsAboveThreshold}" />
                </StackPanel>
              </StackPanel>
              <!-- Package 53: hear yourself the way the others do -->
              <DockPanel Classes="selfTest" Margin="0,4,0,0">
                <Button Command="{Binding ToggleSelfTestCommand}" Classes.accent="{Binding IsSelfTesting}"
                        AutomationProperties.Name="{Binding SelfTestText}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Headphones}" Classes="sm" />
                    <TextBlock Text="{Binding SelfTestText}" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{x:Static l:Strings.Ui_SelfTestHint}" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Keys: a free list (Package 41). Keys work globally, also while a game has the focus. -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_KeysSection}" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{x:Static l:Strings.Ui_KeysHelp}" />
              <TextBlock Classes="muted" Text="{x:Static l:Strings.Ui_NoKeyActions}" IsVisible="{Binding !HasKeyBindings}" />
              <ItemsControl ItemsSource="{Binding KeyBindings}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyBindingItem">
                    <DockPanel>
                      <StackPanel Classes="keyActions" Orientation="Horizontal" Spacing="4">
                        <Button Command="{Binding EditCommand}" AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_ChangeFmt}}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="sm" Data="{StaticResource Icon.Edit}" />
                            <TextBlock Text="{x:Static l:Strings.Ui_ChangeMenu}" />
                          </StackPanel>
                        </Button>
                        <Button Classes="icon" Command="{Binding RemoveCommand}"
                                ToolTip.Tip="{x:Static l:Strings.Ui_Delete}" AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_DeleteFmt}}">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                        </Button>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{Binding Label}" TextWrapping="Wrap" />
                        <Border Classes="keycap" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding ChordName}" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="subtle" Command="{Binding AddKeyBindingCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.Add}" />
                  <TextBlock Text="{x:Static l:Strings.Dlg_AddKeyAction}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Sounds (Package 47) -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_SoundsSection}" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_SoundsHint}" />
              <CheckBox Content="{x:Static l:Strings.Ui_AllSoundsOff}" IsChecked="{Binding AllSoundsOff}" />
              <DockPanel IsEnabled="{Binding !AllSoundsOff}">
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding SoundVolumePercent, StringFormat='{}{0:0} %'}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_SoundVolume}" />
              </DockPanel>
              <Slider Minimum="0" Maximum="100" Value="{Binding SoundVolumePercent}" IsEnabled="{Binding !AllSoundsOff}"
                      AutomationProperties.Name="{x:Static l:Strings.Ui_SoundVolume}" />
              <!-- Package 48: every sound on its own -->
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_SoundsEachHint}" Margin="0,6,0,0" />
              <!-- Package 77: below 670 px name and controls no longer fit side by side (German texts), the controls go below -->
              <ItemsControl ItemsSource="{Binding SoundRows}" IsEnabled="{Binding !AllSoundsOff}" v:Responsive.StackBelow="670">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SoundRow">
                    <Border Classes="soundRow">
                      <StackPanel Spacing="4">
                        <!-- Package 77: one line when wide; when stacked the controls move below play and name (Controls.axaml) -->
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                          <Button Classes="icon" Command="{Binding PlayCommand}" Margin="0,0,6,0"
                                  ToolTip.Tip="{Binding Label, StringFormat={x:Static l:Strings.Ui_PlayFmt}}"
                                  AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_PlayFmt}}">
                            <PathIcon Classes="sm" Data="{StaticResource Icon.Play}" />
                          </Button>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Package 73: longer names may be cut off on wide windows, the tooltip shows them whole -->
                            <TextBlock Classes="label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                            <TextBlock Classes="caption" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Grid Classes="soundControls" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" IsEnabled="{Binding !Muted}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_SoundVolumeFmt}}" />
                            <TextBlock Grid.Column="1" Classes="muted" Width="44" Margin="6,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding VolumePercent, StringFormat='{}{0:0} %'}" />
                            <WrapPanel ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
                              <CheckBox Content="{x:Static l:Strings.Ui_Muted}" IsChecked="{Binding Muted}"
                                        AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_SoundMutedFmt}}" />
                              <Button Click="OnPickSound" Content="{x:Static l:Strings.Ui_ChooseFile}"
                                      AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_ChooseFileFmt}}" />
                              <Button Classes="icon" Command="{Binding ResetCommand}"
                                      ToolTip.Tip="{x:Static l:Strings.Ui_Reset}"
                                      AutomationProperties.Name="{Binding Label, StringFormat={x:Static l:Strings.Ui_ResetFmt}}">
                                <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
                              </Button>
                            </WrapPanel>
                          </Grid>
                        </Grid>
                        <TextBlock Classes="danger" Text="{Binding Error}" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_AppearanceSection}" />
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_Theme}" />
              <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding SelectedTheme}" Classes="settingsChoice">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <!-- Package 45 -->
              <TextBlock Classes="label" Text="{x:Static l:Strings.Settings_Language}" Margin="0,10,0,0" />
              <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Languages}" SelectedItem="{Binding SelectedLanguage}" Classes="settingsChoice"
                        AutomationProperties.Name="{x:Static l:Strings.Settings_Language}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" Text="{x:Static l:Strings.Settings_LanguageHint}" />
              <!-- Package 61: see-through backgrounds -->
              <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding BackgroundOpacityPercent, StringFormat='{}{0:0} %'}" />
                <TextBlock Classes="label" Text="{x:Static l:Strings.Ui_BackgroundOpacity}" />
              </DockPanel>
              <Slider Minimum="0" Maximum="100" Value="{Binding BackgroundOpacityPercent}" AutomationProperties.Name="{x:Static l:Strings.Ui_BackgroundOpacity}" />
              <CheckBox Content="{x:Static l:Strings.Ui_BlurBackground}" IsChecked="{Binding BlurBackground}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Strings.Ui_BackgroundOpacityHint}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- About (Package 42) -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{x:Static l:Strings.Ui_AboutSection}" />
          <Border Classes="card">
            <StackPanel Spacing="4">
              <SelectableTextBlock Classes="label" Text="{Binding AppVersion}" />
              <TextBlock Classes="caption" Text="{Binding BuildDetails}" />
              <CheckBox Content="{x:Static l:Strings.Ui_CheckUpdatesAtStart}" IsChecked="{Binding CheckForUpdates}" Margin="0,8,0,0" />
              <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding CheckUpdatesCommand}" Margin="0,0,10,0" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="sm" Data="{StaticResource Icon.ArrowSync}" />
                    <TextBlock Text="{x:Static l:Strings.Ui_CheckUpdates}" />
                  </StackPanel>
                </Button>
                <!-- Package 98: a spinner next to the text while the check runs -->
                <v:BusySpinner Name="UpdateCheckBusy" DockPanel.Dock="Left" Margin="0,0,6,0" IsVisible="{Binding Checking.IsBusy}" />
                <TextBlock Classes="caption" Text="{Binding UpdateStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
