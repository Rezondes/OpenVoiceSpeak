<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OVS.Client.ViewModels"
             x:Class="OVS.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel>
    <!-- Page header: title and close (Esc closes as well) -->
    <Border DockPanel.Dock="Top" Padding="24,12,16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CancelCommand}"
                ToolTip.Tip="Schliessen (Esc)" AutomationProperties.Name="Einstellungen schliessen">
          <PathIcon Data="{StaticResource Icon.Dismiss}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Ovs.AccentSurface}">
            <PathIcon Classes="accent" Data="{StaticResource Icon.Settings}" />
          </Border>
          <TextBlock Classes="h2" FontSize="17" Text="Einstellungen" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Button bar -->
    <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource Ovs.Sidebar}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ovs.Border}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Abbrechen" Command="{Binding CancelCommand}" MinWidth="96" HorizontalContentAlignment="Center" />
          <Button Classes="accent" Content="Speichern" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                  MinWidth="96" HorizontalContentAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="danger" Text="{Binding Error}" IsVisible="{Binding HasKeyConflict}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="24,20" Spacing="20" MaxWidth="720" HorizontalAlignment="Stretch">

        <!-- Devices -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="GERÄTE" />
          <Border Classes="card">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Mikrofon" />
                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioDeviceOption">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="Lautsprecher" />
                <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioDeviceOption">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Border Classes="banner warning" IsVisible="{Binding DeviceHint, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="warning" Data="{StaticResource Icon.Warning}" />
                  <TextBlock Classes="warning" Text="{Binding DeviceHint}" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Volume -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="LAUTSTÄRKE" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding InputGainPercent, StringFormat='{}{0:0} %'}" />
                <TextBlock Classes="label" Text="Mikrofonverstärkung" />
              </DockPanel>
              <Slider Minimum="0" Maximum="200" Value="{Binding InputGainPercent}" AutomationProperties.Name="Mikrofonverstärkung" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding OutputVolumePercent, StringFormat='{}{0:0} %'}" />
                <TextBlock Classes="label" Text="Lautstärke" />
              </DockPanel>
              <Slider Minimum="0" Maximum="100" Value="{Binding OutputVolumePercent}" AutomationProperties.Name="Lautstärke" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Transmit mode -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="ÜBERTRAGUNG" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <RadioButton Content="Push-to-Talk: senden, solange die Taste gedrückt ist" IsChecked="{Binding IsPushToTalk}" />
              <RadioButton Content="Sprachaktivierung: senden, sobald du sprichst" IsChecked="{Binding VoiceActivation}" />
              <StackPanel Spacing="6" IsVisible="{Binding VoiceActivation}" Margin="28,4,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding VadThresholdDb, StringFormat='{}{0:0} dBFS'}" />
                  <TextBlock Classes="label" Text="Schwelle" />
                </DockPanel>
                <!-- Meter and threshold slider share one scale, so the slider thumb marks the threshold on the meter. -->
                <ProgressBar Minimum="-60" Maximum="-10" Value="{Binding InputLevelDb}" Height="8" Margin="10,0" CornerRadius="4" />
                <Slider Minimum="-60" Maximum="-10" Value="{Binding VadThresholdDb}" Margin="0,-6,0,0" AutomationProperties.Name="Schwelle der Sprachaktivierung" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="caption" Text="{Binding InputLevelDb, StringFormat='Pegel {0:0} dBFS'}" />
                  <TextBlock Classes="caption speaking" Text="über der Schwelle, würde senden" IsVisible="{Binding IsAboveThreshold}" />
                  <TextBlock Classes="caption" Text="unter der Schwelle" IsVisible="{Binding !IsAboveThreshold}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Keys: a free list (Package 41). Keys work globally, also while a game has the focus. -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="TASTEN" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Tasten wirken überall, auch während ein Spiel im Vordergrund ist. Kombinationen mit Strg, Umschalt und Alt sind möglich." />
              <TextBlock Classes="muted" Text="Noch keine Tastenaktionen." IsVisible="{Binding !HasKeyBindings}" />
              <ItemsControl ItemsSource="{Binding KeyBindings}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyBindingItem">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Command="{Binding EditCommand}" AutomationProperties.Name="{Binding Label, StringFormat='{}{0}: ändern'}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="sm" Data="{StaticResource Icon.Edit}" />
                            <TextBlock Text="Ändern ..." />
                          </StackPanel>
                        </Button>
                        <Button Classes="icon" Command="{Binding RemoveCommand}"
                                ToolTip.Tip="Löschen" AutomationProperties.Name="{Binding Label, StringFormat='{}{0}: löschen'}">
                          <PathIcon Classes="sm" Data="{StaticResource Icon.Delete}" />
                        </Button>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{Binding Label}" />
                        <Border Classes="keycap" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding ChordName}" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="subtle" Command="{Binding AddKeyBindingCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="sm" Data="{StaticResource Icon.Add}" />
                  <TextBlock Text="Tastenaktion hinzufügen" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="DARSTELLUNG" />
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Design" />
              <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding SelectedTheme}" MinWidth="200">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- About (Package 42) -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="ÜBER" />
          <Border Classes="card">
            <StackPanel Spacing="4">
              <SelectableTextBlock Classes="label" Text="{Binding AppVersion}" />
              <TextBlock Classes="caption" Text="{Binding BuildDetails}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
