<!--
  Shared looks on top of FluentTheme: text roles, cards, rows, avatars, chips and button variants.
  Colors only through the tokens in Theme.axaml. Transitions stay short (at most 150 ms) and only
  show a state change, such as hover or someone starting to speak.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Width steps (Package 68, A93): classes set on the window by Views/Responsive.cs ===== -->
  <!-- Only below 700 px window width, e.g. the button that opens the sidebar drawer -->
  <Style Selector="Window:not(.compact) :is(Control).compactOnly">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Hidden while the main area is under 560 px, e.g. button texts next to an icon (tooltip keeps the text) -->
  <Style Selector="Window.narrow :is(Control).wideOnly">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===== Text roles ===== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.DangerText}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.WarningText}" />
  </Style>
  <Style Selector="TextBlock.speaking">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Speaking}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.AccentText}" />
  </Style>

  <!-- ===== Icons ===== -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="PathIcon.sm">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="PathIcon.muted">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
  </Style>
  <Style Selector="PathIcon.danger">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.DangerText}" />
  </Style>
  <Style Selector="PathIcon.warning">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.WarningText}" />
  </Style>
  <Style Selector="PathIcon.accent">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.AccentText}" />
  </Style>
  <Style Selector="PathIcon.link">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Link}" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Ovs.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- Dialog card on the overlay layer -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource Ovs.DialogBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 12 40 0 #66000000" />
  </Style>
  <Style Selector="Border.card.welcome">
    <Setter Property="Background" Value="{DynamicResource Ovs.AccentSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Accent}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.banner.warning">
    <Setter Property="Background" Value="{DynamicResource Ovs.WarningSurface}" />
  </Style>
  <Style Selector="Border.banner.danger">
    <Setter Property="Background" Value="{DynamicResource Ovs.DangerSurface}" />
  </Style>
  <Style Selector="Border.banner.accent">
    <Setter Property="Background" Value="{DynamicResource Ovs.AccentSurface}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Ovs.Border}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.keycap">
    <Setter Property="Background" Value="{DynamicResource Ovs.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Border}" />
    <Setter Property="BorderThickness" Value="1,1,1,3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.keycap TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <!-- Square with the first letter of the server name -->
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Ovs.Accent}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Rows in the channel tree ===== -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
  </Style>
  <Style Selector="Border.row.current">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceSelected}" />
  </Style>
  <Style Selector="Border.row.current TextBlock.channelName">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.AccentText}" />
  </Style>
  <!-- Package 66: the muted-channel icon keeps its warning colour in the current channel -->
  <Style Selector="Border.row.current PathIcon.channelIcon:not(.warning)">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.AccentText}" />
  </Style>

  <!-- ===== Avatars with speaking ring ===== -->
  <Style Selector="Border.ring">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="CornerRadius" Value="99" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.ring.speaking">
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Speaking}" />
  </Style>
  <Style Selector="Border.ring.link">
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Link}" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="CornerRadius" Value="99" />
  </Style>
  <Style Selector="Border.avatar TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource Ovs.TextMuted}" />
  </Style>
  <Style Selector="Ellipse.dot.online">
    <Setter Property="Fill" Value="{DynamicResource Ovs.Speaking}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.accent, Button.danger, Button.subtle">
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- Icon-only buttons: 36 x 36, the name comes from AutomationProperties.Name and a tooltip. -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.Border}" />
  </Style>
  <!-- A checked icon toggle means "off" (muted, deafened): red, not the accent blue. -->
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.DangerSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.DangerText}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.DangerSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.DangerText}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:disabled, ToggleButton.icon:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Window buttons in the title bar: not tab stops, close turns red -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.TextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
  </Style>
  <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.Border}" />
  </Style>

  <!-- Text that works like a link, e.g. the "no PTT key" hint -->
  <Style Selector="Button.hint">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.hint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.hint:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Quiet text button with icon, for secondary header actions -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>

  <!-- Destructive actions: red, separate from the primary accent button -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Ovs.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.DangerHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.DangerHover}" />
  </Style>

  <!-- Icons inside filled buttons take the button's text color -->
  <Style Selector="Button.accent PathIcon, Button.danger PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
  </Style>

  <!-- Bookmark tiles on the start screen -->
  <!-- A bookmark in the sidebar (Package 40) -->
  <Style Selector="Button.bookmark">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.bookmark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
  </Style>
  <Style Selector="Button.tile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Ovs.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Accent}" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- Package 78: the tab headers stay in one line and scroll sideways when they do not fit -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0,12,0,0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ScrollViewer Name="PART_TabStrip" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
          <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Window.narrow TabItem">
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <!-- Where a dragged channel or group lands (Package 36, 37) -->
  <Style Selector="Border.dropLine">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="Background" Value="{DynamicResource Ovs.Accent}" />
  </Style>

  <!-- One field of the link matrix; pending changes are tinted (Package 38) -->
  <Style Selector="Border.linkCell">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.linkCell.pending">
    <Setter Property="Background" Value="{DynamicResource Ovs.AccentSurface}" />
  </Style>

  <!-- ===== Administration (Package 78): as before from 560 px, stacked below (Window.narrow) ===== -->
  <Style Selector="DockPanel.adminBody">
    <Setter Property="Margin" Value="24,12,24,16" />
  </Style>
  <Style Selector="Window.narrow DockPanel.adminBody">
    <Setter Property="Margin" Value="12,8,12,12" />
  </Style>
  <!-- Groups: list (240 px) beside the editor; under narrow the list on top (40 % of the height), the editor below -->
  <Style Selector="Grid.adminGroups > Border.groupList">
    <Setter Property="Width" Value="240" />
    <Setter Property="Grid.RowSpan" Value="2" />
  </Style>
  <Style Selector="Grid.adminGroups > Border.groupEditor">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.RowSpan" Value="2" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector="Window.narrow Grid.adminGroups > Border.groupList">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Grid.RowSpan" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="Window.narrow Grid.adminGroups > Border.groupEditor">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.RowSpan" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style Selector="UniformGrid.rights">
    <Setter Property="Columns" Value="2" />
  </Style>
  <Style Selector="Window.narrow UniformGrid.rights">
    <Setter Property="Columns" Value="1" />
  </Style>
  <!-- Action of a user or ban card: beside the details, under narrow below them -->
  <Style Selector="Button.cardAction">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.narrow Button.cardAction">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- Link matrix: fixed title column, narrower titles under narrow -->
  <Style Selector=":is(Control).linkHeader">
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="TextBlock.linkTitle">
    <Setter Property="Width" Value="192" />
  </Style>
  <Style Selector="Window.narrow TextBlock.linkTitle">
    <Setter Property="Width" Value="112" />
  </Style>

  <!-- One sound in the settings (Package 48) -->
  <Style Selector="Border.soundRow">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Ovs.SurfaceHover}" />
  </Style>

  <!-- ===== Settings page (Package 77): as before from 560 px, stacked below (Window.narrow) ===== -->
  <Style Selector="Border.settingsHeader">
    <Setter Property="Padding" Value="24,12,16,12" />
  </Style>
  <Style Selector="Border.settingsBar">
    <Setter Property="Padding" Value="24,12" />
  </Style>
  <Style Selector="StackPanel.settingsBody">
    <Setter Property="Margin" Value="24,20" />
  </Style>
  <Style Selector="Window.narrow Border.settingsHeader">
    <Setter Property="Padding" Value="12,12,8,12" />
  </Style>
  <Style Selector="Window.narrow Border.settingsBar">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Window.narrow StackPanel.settingsBody">
    <Setter Property="Margin" Value="12,16" />
  </Style>
  <!-- Sound row: controls beside the name; stacked (Responsive.StackBelow) in a line below it, under narrow the buttons in a third -->
  <Style Selector="Grid.soundControls Slider">
    <Setter Property="Width" Value="150" />
  </Style>
  <Style Selector="Grid.soundControls WrapPanel">
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector="Grid.soundControls">
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="ItemsControl.stacked Grid.soundControls">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="3" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="ItemsControl.stacked Grid.soundControls Slider">
    <Setter Property="Width" Value="NaN" />
  </Style>
  <Style Selector="Window.narrow Grid.soundControls WrapPanel">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="3" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- Label beside its buttons, under narrow the buttons go below -->
  <Style Selector="StackPanel.keyActions">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.narrow StackPanel.keyActions">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="Button.pttKey">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector="Window.narrow Button.pttKey">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="DockPanel.selfTest > Button">
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="DockPanel.selfTest > TextBlock">
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>
  <Style Selector="Window.narrow DockPanel.selfTest > Button">
    <Setter Property="DockPanel.Dock" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Window.narrow DockPanel.selfTest > TextBlock">
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="ComboBox.settingsChoice">
    <Setter Property="MinWidth" Value="200" />
  </Style>
  <Style Selector="Window.narrow ComboBox.settingsChoice">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- ===== Chat (Package 32) ===== -->
  <Style Selector="TabStripItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <!-- Unread counter on a tab -->
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource Ovs.Accent}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TabStripItem TextBlock.offline">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.icon.tabClose">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2,0,-6,0" />
  </Style>
  <Style Selector="TextBlock.author">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
  <Style Selector="TextBlock.author.own">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.AccentText}" />
  </Style>
  <!-- Package 64: chat bubbles, neutral for others, accent for the own messages -->
  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="{DynamicResource Ovs.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ovs.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Border.bubble.own">
    <Setter Property="Background" Value="{DynamicResource Ovs.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.bubble.own SelectableTextBlock.message">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
    <Setter Property="SelectionBrush" Value="#66FFFFFF" />
  </Style>
  <Style Selector="Border.bubble.own TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource Ovs.OnAccent}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <!-- Package 79: 75 % of the history for a bubble, 85 % under narrow (columns 15*,2*,3* and 3*,2*,15*) -->
  <Style Selector="Grid > DockPanel.otherMessage">
    <Setter Property="Grid.ColumnSpan" Value="1" />
  </Style>
  <Style Selector="Window.narrow Grid > DockPanel.otherMessage">
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="Grid > Border.bubble.own">
    <Setter Property="Grid.Column" Value="2" />
  </Style>
  <Style Selector="Window.narrow Grid > Border.bubble.own">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <!-- Package 79: paddings of the chat, 12 px under narrow -->
  <Style Selector="Border.chatTabs">
    <Setter Property="Padding" Value="16,0" />
  </Style>
  <Style Selector="Window.narrow Border.chatTabs">
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="StackPanel.chatComposer">
    <Setter Property="Margin" Value="20,8,20,16" />
  </Style>
  <Style Selector="Window.narrow StackPanel.chatComposer">
    <Setter Property="Margin" Value="12,8,12,12" />
  </Style>
  <Style Selector="ItemsControl.chatHistory">
    <Setter Property="Margin" Value="20,12" />
  </Style>
  <Style Selector="Window.narrow ItemsControl.chatHistory">
    <Setter Property="Margin" Value="12" />
  </Style>
  <!-- Package 79: the start screen, 16 px from the edges under compact -->
  <Style Selector="StackPanel.startScreen">
    <Setter Property="Margin" Value="32" />
  </Style>
  <Style Selector="Window.compact StackPanel.startScreen">
    <Setter Property="Margin" Value="16" />
  </Style>
  <Style Selector="SelectableTextBlock.message">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Ovs.Text}" />
  </Style>
</Styles>
