<!--
  Design tokens for both theme variants. Views use them only via DynamicResource, never raw colors,
  so switching between light and dark follows automatically.
  Text on backgrounds is at least 4.5:1, white on Accent and Danger as well.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Ovs.Bg" Color="#111318" />
      <!-- Package 61: dialogs keep solid copies when the backgrounds become see-through -->
      <SolidColorBrush x:Key="Ovs.DialogBg" Color="#111318" />
      <SolidColorBrush x:Key="Ovs.DialogBar" Color="#17191F" />
      <SolidColorBrush x:Key="Ovs.Sidebar" Color="#17191F" />
      <SolidColorBrush x:Key="Ovs.SidebarFooter" Color="#13151A" />
      <SolidColorBrush x:Key="Ovs.Surface" Color="#1E2128" />
      <SolidColorBrush x:Key="Ovs.SurfaceHover" Color="#272B34" />
      <SolidColorBrush x:Key="Ovs.SurfaceSelected" Color="#22304A" />
      <SolidColorBrush x:Key="Ovs.Border" Color="#2B2F38" />
      <SolidColorBrush x:Key="Ovs.Text" Color="#E8EAEE" />
      <SolidColorBrush x:Key="Ovs.TextMuted" Color="#9CA3AF" />
      <SolidColorBrush x:Key="Ovs.Accent" Color="#2F6FEB" />
      <SolidColorBrush x:Key="Ovs.AccentHover" Color="#2A62D1" />
      <SolidColorBrush x:Key="Ovs.AccentText" Color="#7AA7FF" />
      <SolidColorBrush x:Key="Ovs.AccentSurface" Color="#1B2A45" />
      <SolidColorBrush x:Key="Ovs.OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Ovs.Speaking" Color="#22C55E" />
      <SolidColorBrush x:Key="Ovs.Link" Color="#A78BFA" />
      <SolidColorBrush x:Key="Ovs.Danger" Color="#DC2626" />
      <SolidColorBrush x:Key="Ovs.DangerHover" Color="#B91C1C" />
      <SolidColorBrush x:Key="Ovs.DangerText" Color="#F87171" />
      <SolidColorBrush x:Key="Ovs.DangerSurface" Color="#3A1A1D" />
      <SolidColorBrush x:Key="Ovs.WarningText" Color="#FBBF24" />
      <SolidColorBrush x:Key="Ovs.WarningSurface" Color="#33290F" />
      <SolidColorBrush x:Key="Ovs.Scrim" Color="#B3000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Ovs.Bg" Color="#F4F5F7" />
      <!-- Package 61: dialogs keep solid copies when the backgrounds become see-through -->
      <SolidColorBrush x:Key="Ovs.DialogBg" Color="#F4F5F7" />
      <SolidColorBrush x:Key="Ovs.DialogBar" Color="#EBEDF1" />
      <SolidColorBrush x:Key="Ovs.Sidebar" Color="#EBEDF1" />
      <SolidColorBrush x:Key="Ovs.SidebarFooter" Color="#E3E6EB" />
      <SolidColorBrush x:Key="Ovs.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Ovs.SurfaceHover" Color="#DFE3E9" />
      <SolidColorBrush x:Key="Ovs.SurfaceSelected" Color="#D6E3FC" />
      <SolidColorBrush x:Key="Ovs.Border" Color="#D5D9E0" />
      <SolidColorBrush x:Key="Ovs.Text" Color="#151922" />
      <SolidColorBrush x:Key="Ovs.TextMuted" Color="#556070" />
      <SolidColorBrush x:Key="Ovs.Accent" Color="#2F6FEB" />
      <SolidColorBrush x:Key="Ovs.AccentHover" Color="#2A62D1" />
      <SolidColorBrush x:Key="Ovs.AccentText" Color="#1D4FC4" />
      <SolidColorBrush x:Key="Ovs.AccentSurface" Color="#E3ECFE" />
      <SolidColorBrush x:Key="Ovs.OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Ovs.Speaking" Color="#15803D" />
      <SolidColorBrush x:Key="Ovs.Link" Color="#7C3AED" />
      <SolidColorBrush x:Key="Ovs.Danger" Color="#DC2626" />
      <SolidColorBrush x:Key="Ovs.DangerHover" Color="#B91C1C" />
      <SolidColorBrush x:Key="Ovs.DangerText" Color="#B91C1C" />
      <SolidColorBrush x:Key="Ovs.DangerSurface" Color="#FDE8E8" />
      <SolidColorBrush x:Key="Ovs.WarningText" Color="#92400E" />
      <SolidColorBrush x:Key="Ovs.WarningSurface" Color="#FEF3C7" />
      <SolidColorBrush x:Key="Ovs.Scrim" Color="#80101418" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
