<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OVS.Client.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Theme.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent controls (inputs, sliders, focus rings) take the brand accent and the window color of each variant. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FF2F6FEB" RegionColor="#FF111318" />
        <ColorPaletteResources x:Key="Light" Accent="#FF2F6FEB" RegionColor="#FFF4F5F7" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Styles/Controls.axaml" />
    <StyleInclude Source="/Styles/Motion.axaml" />
  </Application.Styles>
</Application>
