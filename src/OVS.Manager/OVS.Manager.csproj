<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Package M1 (MA1): the web manager, ASP.NET Core with Blazor (interactive server) and EF Core on SQLite -->
  <PropertyGroup>
    <!-- Dockerfile.manager restores before the .razor files are copied; without this the SDK decides at restore that no
         Blazor scripts are needed, and the image serves no _framework/blazor.web.js, so no page becomes interactive -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OVS.Shared\OVS.Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Package M6 (D8): the Docker Engine API, reached only through the socket proxy -->
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <!-- Package M3 (MA1): accounts with hashing, lockout, security stamps and reset tokens -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!-- the migrations are made with the dotnet-ef tool of dotnet-tools.json (dotnet tool restore), which needs this at design time -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <!-- Package M20 (D6): OTLP over http/protobuf; the classes are made from Telemetry/Proto at build time, internal to the manager -->
    <PackageReference Include="Google.Protobuf" Version="3.28.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="all" />
    <!-- Package M26 (D5): SMTP for the password reset and the notifications -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- Package M28: the TOTP QR code as SVG, made in the manager -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- MailKit brings Pkcs 10.0.0, which has known advisories; the patched one of the runtime line -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Telemetry/Proto/*.proto" ProtoRoot="." GrpcServices="None" Access="Internal" />
  </ItemGroup>

  <!-- Package M2: German is the neutral language, English comes as a satellite assembly (like the client, Package 45) -->
  <PropertyGroup>
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>OVS.Manager.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Api\openapi.json" LogicalName="OVS.Manager.Api.openapi.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OVS.Tests" />
  </ItemGroup>

</Project>
