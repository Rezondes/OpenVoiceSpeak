<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Package M1 (MA1): the web manager, ASP.NET Core with Blazor (interactive server) and EF Core on SQLite -->
  <ItemGroup>
    <ProjectReference Include="..\OVS.Shared\OVS.Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Package M3 (MA1): accounts with hashing, lockout, security stamps and reset tokens -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!-- the migrations are made with the dotnet-ef tool of dotnet-tools.json (dotnet tool restore), which needs this at design time -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <!-- Package M2: German is the neutral language, English comes as a satellite assembly (like the client, Package 45) -->
  <PropertyGroup>
    <NeutralLanguage>de</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>OVS.Manager.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OVS.Tests" />
  </ItemGroup>

</Project>
