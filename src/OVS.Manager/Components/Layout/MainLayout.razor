@inherits LayoutComponentBase

<header class="top-bar">
    <span class="app-title">@Strings.App_Title</span>
    <AuthorizeView>
        <nav class="main-nav">
            <a href="/">@Strings.Nav_Home</a>
            <a href="/profile">@Strings.Nav_Profile</a>
            <a href="/audit">@Strings.Nav_Audit</a>
            <a href="/errors">@Strings.ErrorLookup_Title</a>
            <a href="/settings/notifications">@Strings.NotifySettings_Title</a>
            <AuthorizeView Roles="@ManagerRoles.Admin" Context="admin">
                <a href="/accounts">@Strings.Nav_Accounts</a>
                <a href="/servers/new">@Strings.Nav_NewServer</a>
                <a href="/servers/trash">@Strings.Nav_Trash</a>
                <a href="/servers/adopt">@Strings.Adopt_Title</a>
                <a href="/settings/mail">@Strings.MailSettings_Title</a>
                <a href="/settings/backup">@Strings.ManagerBackup_Title</a>
            </AuthorizeView>
        </nav>
    </AuthorizeView>
    <LanguageSwitch />
    <ThemeSwitch />
    <AuthorizeView>
        <form method="post" action="/logout" class="logout">
            <AntiforgeryToken />
            <button type="submit" name="logout" value="logout">@Strings.Logout</button>
        </form>
    </AuthorizeView>
</header>
<main>
    <AuthorizeView>
        <ManagerUpdateBanner />
    </AuthorizeView>
    @Body
</main>
