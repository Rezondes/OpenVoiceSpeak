@page "/reset-password"
@attribute [AllowAnonymous]

<h1>@Strings.Reset_Title</h1>
@if (Done)
{
    <p role="status" data-reset-done>@Strings.Reset_Done</p>
    <p><a href="/login">@Strings.Login_Title</a></p>
}
else
{
    <EditForm Model="Model" FormName="reset" OnValidSubmit="ResetAsync" class="account-form">
        <input type="hidden" name="Model.UserId" value="@Model!.UserId" />
        <input type="hidden" name="Model.Token" value="@Model!.Token" />
        <label>@Strings.Field_NewPassword <span class="password-field"><InputText type="password" @bind-Value="Model!.NewPassword" autocomplete="new-password" /><PasswordShow /></span></label>
        @if (Error is not null)
        {
            <p class="form-error" role="alert" data-reset-error>@Error</p>
        }
        <button type="submit">@Strings.Reset_Submit</button>
    </EditForm>
}
