@page "/settings/backup"
@attribute [Authorize(Roles = ManagerRoles.Admin)]

<h1>@Strings.ManagerBackup_Title</h1>
<p>@Strings.ManagerBackup_Intro</p>
@if (Error is not null)
{
    <p class="form-error" role="alert" data-error>@Error</p>
}
<section>
    <h2>@Strings.ManagerBackup_DownloadTitle</h2>
    <form method="post" action="/settings/backup/download" class="account-form">
        <AntiforgeryToken />
        <input type="hidden" name="form" value="manager-backup-download" />
        <label>@Strings.Field_Password <span class="password-field"><input type="password" name="password" autocomplete="new-password" /><PasswordShow /></span></label>
        <label>@Strings.Field_ConfirmPassword <span class="password-field"><input type="password" name="confirm" autocomplete="new-password" /><PasswordShow /></span></label>
        <button type="submit">@Strings.ManagerBackup_Download</button>
    </form>
</section>
<section>
    <h2>@Strings.ManagerBackup_ScheduleTitle</h2>
    @if (!HasPassword)
    {
        <p class="form-hint" data-no-password>@Strings.ManagerBackup_NeedsPassword</p>
    }
    <EditForm Model="Model" FormName="manager-backup-schedule" OnValidSubmit="SaveAsync" class="account-form">
        <InputRadioGroup @bind-Value="Model!.Interval">
            <fieldset class="choice-group">
                <legend>@Strings.Backups_Interval</legend>
                <label><InputRadio Value="BackupInterval.Off" /> @Strings.Backups_Off</label>
                <label><InputRadio Value="BackupInterval.Daily" /> @Strings.Backups_Daily</label>
                <label><InputRadio Value="BackupInterval.Weekly" /> @Strings.Backups_Weekly</label>
            </fieldset>
        </InputRadioGroup>
        <label>@Strings.Backups_Keep <InputNumber @bind-Value="Model!.Keep" min="1" max="100" /></label>
        <button type="submit">@Strings.Backups_SaveSchedule</button>
    </EditForm>
    @if (Result is not null)
    {
        <p class="@ResultClass" role="status" data-result>@Result</p>
    }
</section>
