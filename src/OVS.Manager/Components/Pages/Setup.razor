@page "/setup"
@attribute [AllowAnonymous]

<h1>@Strings.Setup_Title</h1>
<EditForm Model="Model" FormName="setup" OnValidSubmit="CreateAsync" class="account-form">
    <label>@Strings.Field_UserName <InputText @bind-Value="Model!.UserName" autocomplete="username" /></label>
    <label>@Strings.Field_Password <InputText type="password" @bind-Value="Model!.Password" autocomplete="new-password" /></label>
    <label>@Strings.Field_ConfirmPassword <InputText type="password" @bind-Value="Model!.ConfirmPassword" autocomplete="new-password" /></label>
    @if (Error is not null)
    {
        <p class="form-error" role="alert">@Error</p>
    }
    <button type="submit">@Strings.Setup_Submit</button>
</EditForm>
