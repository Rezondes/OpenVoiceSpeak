@page "/forgot-password"
@attribute [AllowAnonymous]

<h1>@Strings.Forgot_Title</h1>
@if (!Smtp.IsConfigured)
{
    <p data-ask-admin>@Strings.Forgot_AskAdmin</p>
}
else if (Sent)
{
    <p role="status" data-sent>@Strings.Forgot_Sent</p>
}
else
{
    <EditForm Model="Model" FormName="forgot" OnValidSubmit="SendAsync" class="account-form">
        <label>@Strings.Forgot_NameOrEmail <InputText @bind-Value="Model!.NameOrEmail" autocomplete="username" /></label>
        <button type="submit">@Strings.Forgot_Submit</button>
    </EditForm>
}
<p><a href="/login">@Strings.Login_Title</a></p>
