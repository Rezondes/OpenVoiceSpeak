@page "/accounts"
@attribute [Authorize(Roles = ManagerRoles.Admin)]

<h1>@Strings.Accounts_Title</h1>
@if (Message is not null)
{
    <p class="form-ok" role="status">@Message</p>
}
@if (Error is not null)
{
    <p class="form-error" role="alert">@Error</p>
}
<table class="list">
    <thead>
        <tr><th>@Strings.Accounts_ColumnUser</th><th>@Strings.Accounts_ColumnRole</th><th>@Strings.Accounts_ColumnState</th></tr>
    </thead>
    <tbody>
        @foreach (var account in Rows)
        {
            <tr>
                <td><a href="@EditLink(account)">@account.UserName</a></td>
                <td>@RoleText(account)</td>
                <td>@StateText(account)</td>
            </tr>
        }
    </tbody>
</table>

<form method="post" @onsubmit="TogglePolicyAsync" @formname="two-factor-policy" class="account-form">
    <AntiforgeryToken />
    <p>@PolicyText</p>
    <button type="submit" data-two-factor-policy>@PolicyButton</button>
</form>
<h2>@Strings.Accounts_Create</h2>
<EditForm Model="NewModel" FormName="create" OnValidSubmit="CreateAsync" class="account-form">
    <label>@Strings.Field_UserName <InputText @bind-Value="NewModel!.UserName" /></label>
    <label>@Strings.Accounts_StartPassword <InputText type="password" @bind-Value="NewModel!.Password" autocomplete="new-password" /></label>
    <label>@Strings.Field_Email <InputText type="email" @bind-Value="NewModel!.Email" /></label>
    <button type="submit">@Strings.Accounts_Create</button>
</EditForm>
