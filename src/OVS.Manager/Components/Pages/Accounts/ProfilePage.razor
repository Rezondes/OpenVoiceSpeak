@page "/profile"

<h1>@Strings.Profile_Title</h1>
@if (MustChange)
{
    <p class="form-hint">@Strings.Profile_MustChange</p>
}
@if (Message is not null)
{
    <p class="form-ok" role="status">@Message</p>
}
@if (Error is not null)
{
    <p class="form-error" role="alert">@Error</p>
}

<section>
    <h2>@Strings.Profile_PasswordTitle</h2>
    <EditForm Model="PasswordModel" FormName="password" OnValidSubmit="ChangePasswordAsync" class="account-form">
        <label>@Strings.Field_OldPassword <span class="password-field"><InputText type="password" @bind-Value="PasswordModel!.OldPassword" autocomplete="current-password" /><PasswordShow /></span></label>
        <label>@Strings.Field_NewPassword <span class="password-field"><InputText type="password" @bind-Value="PasswordModel!.NewPassword" autocomplete="new-password" /><PasswordShow /></span></label>
        <button type="submit">@Strings.Profile_ChangePassword</button>
    </EditForm>
</section>

<section>
    <p><a href="/profile/two-factor" data-two-factor-link>@Strings.TwoFactor_Title</a></p>
    <p><a href="/profile/api-tokens" data-api-tokens-link>@Strings.ApiTokens_Title</a></p>
    <h2>@Strings.Profile_EmailTitle</h2>
    <EditForm Model="EmailModel" FormName="email" OnValidSubmit="SaveEmailAsync" class="account-form">
        <label>@Strings.Field_Email <InputText type="email" @bind-Value="EmailModel!.Email" autocomplete="email" /></label>
        <button type="submit">@Strings.Profile_SaveEmail</button>
    </EditForm>
</section>

<section>
    <h2>@Strings.Language_Label</h2>
    <EditForm Model="LanguageModel" FormName="language" OnValidSubmit="SaveLanguageAsync" class="account-form">
        <InputRadioGroup @bind-Value="LanguageModel!.Language">
            <div class="choice-group" role="radiogroup" aria-label="@Strings.Language_Label">
                <label><InputRadio Value="@("de")" /> @Strings.Language_German</label>
                <label><InputRadio Value="@("en")" /> @Strings.Language_English</label>
            </div>
        </InputRadioGroup>
        <button type="submit">@Strings.Profile_SaveLanguage</button>
    </EditForm>
</section>

<section>
    <h2>@Strings.Profile_SessionsTitle</h2>
    <ul class="sessions">
        @foreach (var session in SessionList)
        {
            <li class="session">
                @Since(session) @session.UserAgent
                @if (session.Id == CurrentSession)
                {
                    <strong>@Strings.Profile_SessionCurrent</strong>
                }
            </li>
        }
    </ul>
    <form method="post" @onsubmit="EndOthersAsync" @formname="sessions">
        <AntiforgeryToken />
        <button type="submit">@Strings.Profile_EndOthers</button>
    </form>
</section>
