@page "/servers/new"
@attribute [Authorize(Roles = ManagerRoles.Admin)]

<h1>@Strings.Servers_CreateTitle</h1>
@if (NoFreePort)
{
    <p class="form-error" role="alert">@Strings.Servers_AllPortsTaken</p>
}
@if (Error is not null)
{
    <p class="form-error" role="alert">@Error</p>
}
<EditForm Model="Model" FormName="create-server" OnValidSubmit="CreateAsync" class="account-form">
    <label>@Strings.Servers_Name <InputText @bind-Value="Model!.Name" /></label>
    <label>@Strings.Servers_MaxUsers <InputNumber @bind-Value="Model!.MaxUsers" /></label>
    <label>@Strings.Servers_Password <InputText type="password" @bind-Value="Model!.Password" autocomplete="new-password" /></label>
    <label>@Strings.Servers_Version <InputText @bind-Value="Model!.Version" placeholder="@DefaultVersion" /></label>
    <label>@Strings.Servers_TimeZone <InputText @bind-Value="Model!.TimeZone" placeholder="@DefaultTimeZone" /></label>
    <label>@Strings.Servers_Port <InputNumber @bind-Value="Model!.Port" placeholder="@DefaultPort" /></label>
    <label>@Strings.Resources_CpuCores <InputNumber @bind-Value="Model!.CpuCores" data-cpu /></label>
    <label>@Strings.Resources_MemoryMb <InputNumber @bind-Value="Model!.MemoryMb" data-memory /></label>
    <label>@Strings.Clone_From
        <InputSelect @bind-Value="Model!.SourceId" data-source>
            <option value="">@Strings.Clone_None</option>
            @foreach (var source in Sources)
            {
                <option value="@source.Id">@source.Name</option>
            }
        </InputSelect>
    </label>
    <label><InputCheckbox @bind-Value="Model!.CopyUsers" data-copy-users /> @Strings.Clone_Users</label>
    <label><InputCheckbox @bind-Value="Model!.CopyBans" data-copy-bans /> @Strings.Clone_Bans</label>
    <button type="submit" disabled="@NoFreePort">@Strings.Servers_Create</button>
</EditForm>
