@page "/"
@rendermode InteractiveServer
@inherits ServerWatchPage

<h1>@Strings.Home_Title</h1>
@if (!DockerReachable)
{
    <p class="banner-error" role="alert">@Strings.Docker_Unreachable</p>
}
@if (Disk.Read() is { IsLow: true } low)
{
    <p class="banner-error" role="alert" data-disk-low>@DiskLowText(low)</p>
}
@if (Limit.Reached)
{
    <p class="banner-error" role="alert" data-telemetry-limit>@LimitText</p>
}
<section class="dashboard stat-tiles" data-dashboard>
    <StatTile Name="users" Label="@Strings.Live_Users" Value="@UsersText" />
    <StatTile Name="bandwidth" Label="@Strings.Dashboard_Bandwidth" Value="@BandwidthText" Unit="kbit/s" />
    <StatTile Name="ports" Label="@Strings.Dashboard_Ports" Value="@PortsText" />
    <StatTile Name="status" Label="@Strings.Dashboard_Status" Value="@StatusText" />
    <StatTile Name="updates" Label="@Strings.Dashboard_Updates" Value="@UpdatesText" />
    <StatTile Name="disk" Label="@Strings.Resources_DiskFree" Value="@DiskText" />
</section>
<AuthorizeView Roles="@ManagerRoles.Admin">
    <p>
        <button type="button" data-update-all disabled="@UpdatingAll" @onclick="UpdateAllAsync">@Strings.Update_All</button>
        @if (UpdateAllText is not null)
        {
            <span class="form-hint" role="status" data-update-all-result>@UpdateAllText</span>
        }
    </p>
</AuthorizeView>
@if (!VisibleServers.Any())
{
    <p>@Strings.Servers_Empty</p>
}
else
{
    <table class="list">
        <thead>
            <tr>
                <th>@Strings.Servers_Name</th><th>@Strings.Servers_ColumnStatus</th><th>@Strings.Servers_Version</th>
                <th>@Strings.Servers_ColumnPort</th><th>@Strings.Servers_ColumnUsers</th><th>@Strings.Servers_ColumnErrors</th><th>@Strings.Servers_ColumnUptime</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var server in VisibleServers)
            {
                <tr @key="server.Id" data-server="@server.Id">
                    <td><a href="@($"/servers/{server.Id}")">@server.Name</a> <span class="link-state">@ServerTexts.Link(Connections.LinkOf(server.Id))</span></td>
                    <td data-status="@server.Status">@ServerTexts.Status(server)</td>
                    <td>@server.Version <span class="update-offer">@OfferText(server)</span></td>
                    <td>@server.Port</td>
                    <td>@ServerTexts.UsersOnline(Connections.LinkOf(server.Id))</td>
                    <td data-errors><a href="@($"/servers/{server.Id}/errors")">@ErrorCount(server)</a></td>
                    <td>@ServerTexts.Uptime(server, Time.GetUtcNow())</td>
                    <td><ServerActions ServerId="@server.Id" Busy="@Watcher.IsBusy(server.Id)" /></td>
                </tr>
            }
        </tbody>
    </table>
}
