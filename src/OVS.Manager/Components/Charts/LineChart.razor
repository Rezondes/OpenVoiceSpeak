<figure class="line-chart" data-chart="@Title">
    <figcaption>@Title (@Unit)</figcaption>
    <svg viewBox="0 0 600 180" role="img" aria-label="@Title">
        @foreach (var tick in YTicks)
        {
            <line x1="56" x2="592" y1="@tick.Position" y2="@tick.Position" stroke="var(--border)" />
            <g><text x="52" y="@tick.Position" text-anchor="end" dominant-baseline="middle" fill="var(--muted)" font-size="11" data-y-tick>@tick.Label</text></g>
        }
        @foreach (var tick in XTicks)
        {
            <g><text x="@tick.Position" y="176" text-anchor="middle" fill="var(--muted)" font-size="11" data-x-tick>@tick.Label</text></g>
        }
        @foreach (var line in Lines)
        {
            <polyline points="@line.Points" fill="none" stroke="@line.Color" stroke-width="2" />
            @foreach (var dot in line.Dots)
            {
                <circle cx="@dot.Across" cy="@dot.Down" r="3" fill="@line.Color"><title>@dot.Tooltip</title></circle>
            }
        }
    </svg>
    @if (Series.Count > 1)
    {
        <p class="chart-legend">
            @foreach (var series in Series)
            {
                <span style="@LegendStyle(series)">@series.Name</span>
            }
        </p>
    }
</figure>
